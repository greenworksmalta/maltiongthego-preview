    {
      "id": "grammar4",
      "icon": "📖",
      "title": "Grammar",
      "subtitle": "Il-grammatika — the grammar of Lesson 4",
      "intro": "Two ways to show 'whose': the word ta', and the attached pronouns.",
      "rules": [
        {
          "id": "ta-possessive",
          "title": "Possessive with ta' (of)",
          "explanation": "The simplest way to show possession: noun + ta' + owner. Literally 'X of Y'. Use 'ta'' for any owner — names, family members, things.",
          "examples": [
            {
              "mt": "Il-kelb ta' Matthew",
              "en": "Matthew's dog"
            },
            {
              "mt": "Il-pupa ta' Sarah",
              "en": "Sarah's doll"
            },
            {
              "mt": "Il-ktieb ta' Sean",
              "en": "Sean's book"
            },
            {
              "mt": "Il-basket ta' Maria",
              "en": "Maria's bag"
            },
            {
              "mt": "Ir-rota ta' Jessica",
              "en": "Jessica's bike"
            },
            {
              "mt": "It-tfal ta' Marika",
              "en": "Marika's children"
            }
          ]
        },
        {
          "id": "possessive-pronouns",
          "title": "Possessive pronouns — tiegħi, tiegħek, tiegħu…",
          "explanation": "When the owner is a pronoun (my, your, his, her…), use one of these standalone words AFTER the noun. They agree with the OWNER, not the noun.",
          "letters": [
            "Tiegħi",
            "Tiegħek",
            "Tiegħu",
            "Tagħha",
            "Tagħna",
            "Tagħkom",
            "Tagħhom"
          ],
          "examples": [
            {
              "mt": "Il-kelb tiegħi",
              "en": "My dog"
            },
            {
              "mt": "Il-kelb tiegħek",
              "en": "Your dog"
            },
            {
              "mt": "Il-kelb tiegħu",
              "en": "His dog"
            },
            {
              "mt": "Il-kelb tagħha",
              "en": "Her dog"
            },
            {
              "mt": "Il-kelb tagħna",
              "en": "Our dog"
            },
            {
              "mt": "Il-kelb tagħkom",
              "en": "Your dog (pl)"
            },
            {
              "mt": "Il-kelb tagħhom",
              "en": "Their dog"
            }
          ]
        },
        {
          "id": "attached-pronouns",
          "title": "Attached pronouns — suffix straight onto the noun",
          "explanation": "Instead of 'dar tiegħi' (my house), Maltese often attaches a tiny suffix to the noun: dari. The suffixes are -i (my), -ek (your), -u (his), -ha (her), -na (our), -kom (your pl), -hom (their). The article drops away.",
          "letters": [
            "-i (my)",
            "-ek (your)",
            "-u (his)",
            "-ha (her)",
            "-na (our)",
            "-kom (your pl)",
            "-hom (their)"
          ],
          "examples": [
            {
              "mt": "dar tiegħi → dari",
              "en": "my house"
            },
            {
              "mt": "dar tiegħek → darek",
              "en": "your house"
            },
            {
              "mt": "dar tiegħu → daru",
              "en": "his house"
            },
            {
              "mt": "missier tagħha → missierha",
              "en": "her father"
            },
            {
              "mt": "missier tagħna → missierna",
              "en": "our father"
            },
            {
              "mt": "qalb tiegħi → qalbi",
              "en": "my heart"
            },
            {
              "mt": "art tagħhom → arthom",
              "en": "their land"
            }
          ]
        },
        {
          "id": "family-plurals",
          "title": "Family member plurals are irregular",
          "explanation": "Family-member plurals don't follow a single pattern — many take -ijiet or -iet, some are completely different. Memorise the pairs.",
          "examples": [
            {
              "mt": "omm → ommijiet",
              "en": "mother → mothers"
            },
            {
              "mt": "missier → missirijiet",
              "en": "father → fathers"
            },
            {
              "mt": "nanna → nanniet",
              "en": "grandmother → grandmothers"
            },
            {
              "mt": "iben/bint → ulied",
              "en": "son/daughter → children (shared plural)"
            },
            {
              "mt": "ziju/zija → zijiet",
              "en": "uncle/aunt → uncles & aunts"
            },
            {
              "mt": "kuġin/kuġina → kuġini",
              "en": "cousin → cousins"
            },
            {
              "mt": "għarus/għarusa → għarajjes",
              "en": "fiancé/fiancée → engaged couples"
            }
          ]
        }
      ]
    }
