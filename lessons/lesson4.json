    {
      "id": "attached",
      "icon": "➕",
      "title": "Attached pronouns",
      "subtitle": "Il-pronomi mehmużin — suffixes",
      "intro": "Maltese has a powerful shortcut: the pronoun (my, your, his…) attaches to the noun as a suffix. So 'my house' is one word: dari.",
      "examples": [
        {
          "long": "missier tiegħi",
          "short": "missieri",
          "en": "my father"
        },
        {
          "long": "missier tiegħek",
          "short": "missierek",
          "en": "your father"
        },
        {
          "long": "missier tiegħu",
          "short": "missieru",
          "en": "his father"
        },
        {
          "long": "missier tagħha",
          "short": "missierha",
          "en": "her father"
        },
        {
          "long": "missier tagħna",
          "short": "missierna",
          "en": "our father"
        },
        {
          "long": "missier tagħkom",
          "short": "missierkom",
          "en": "your (pl) father"
        },
        {
          "long": "missier tagħhom",
          "short": "missierhom",
          "en": "their father"
        }
      ],
      "exercises": [
