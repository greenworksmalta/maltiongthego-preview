    {
      "id": "possessive",
      "icon": "🏷️",
      "title": "Possessive",
      "subtitle": "Il-possessiv — using ta' and tiegħi/tiegħek/etc",
      "intro": "To say 'someone's something' in Maltese, use the small word ta' (of). 'Sara's dog' becomes 'the dog of Sara'.",
      "examples": [
        {
          "phrase": "Il-kelb ta' Sara",
          "en": "Sara's dog"
        },
        {
          "phrase": "Id-dar ta' Tom",
          "en": "Tom's house"
        },
        {
          "phrase": "Il-karozza tal-missier",
          "en": "Father's car"
        },
        {
          "phrase": "Il-ġuvni ta' Marta",
          "en": "Marta's boyfriend"
        },
        {
          "phrase": "Il-villa tan-nanna",
          "en": "Grandmother's villa"
        },
        {
          "phrase": "Il-pjanti taz-zija",
          "en": "Aunt's plants"
        }
