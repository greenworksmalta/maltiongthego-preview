    {
      "id": "grammar7",
      "icon": "📖",
      "title": "Grammar",
      "subtitle": "Il-grammatika — the grammar of Lesson 7",
      "intro": "These are the grammar points covered in the slides. Each rule has examples drawn from the lesson.",
      "rules": [
        {
          "id": "future-se",
          "title": "Future with 'Se' + verb",
          "explanation": "To say 'I'm going to (do something)', put 'Se' before the verb. The verb stays in its 1st-person present form. 'Se mmur' = 'I'm going' / 'I'm going to go'.",
          "examples": [
            {
              "mt": "Se mmur il-baħar",
              "en": "I'm going to the beach"
            },
            {
              "mt": "Se mmur nixtri",
              "en": "I'm going shopping"
            },
            {
              "mt": "Se mmur nieħu ġelat",
              "en": "I'm going to have an ice-cream"
            },
            {
              "mt": "Se nibqa' ġewwa",
              "en": "I'm going to stay at home"
            },
            {
              "mt": "Se nara film",
              "en": "I'm going to watch a film"
            }
          ]
        },
        {
          "id": "verb-stacking",
          "title": "Stacking verbs after 'Se mmur'",
          "explanation": "After 'Se mmur' (I'm going) you often add a second verb to say what you'll do there. Both verbs stay in the 1st-person form. No 'to' between them.",
          "examples": [
            {
              "mt": "Se mmur inżur mużew",
              "en": "I'm going to visit a museum"
            },
            {
