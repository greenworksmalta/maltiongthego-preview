      "id": "grammar8",
      "icon": "📖",
      "title": "Gramática",
      "subtitle": "Il-grammatika — la gramática de la Lección 8",
      "intro": "Estos son los puntos gramaticales de las diapositivas. Se basan en la Lección 1 (el artículo) y la Lección 7 (las partículas).",
      "rules": [
        {
          "id": "date-format",
          "title": "Escribir la fecha",
          "explanation": "El orden de la fecha en maltés es: día de la semana + número + ta' + mes + año. La pequeña palabra 'ta'' aquí significa 'de' — '24 de febrero'. Usa 'Nhar' antes de un día si quieres decir 'el lunes' específicamente.",
          "examples": [
            {
              "mt": "It-Tnejn 24 ta' Frar, 2024",
              "en": "Lunes 24 de febrero de 2024"
            },
            {
              "mt": "Il-Ġimgħa 5 ta' Mejju, 2026",
              "en": "Viernes 5 de mayo de 2026"
            },
            {
              "mt": "Nhar it-Tlieta",
              "en": "El martes"
            },
            {
              "mt": "Ix-xahar id-dieħel",
              "en": "El próximo mes"
            }
          ]
        },
        {
          "id": "particle-fusion",
          "title": "Partícula + artículo = una sola palabra",
          "explanation": "Cuando una partícula (ma', ta', sa, ġo, bi, fi, lil, bħal, għal, minn) va seguida de 'l-' (el/la), se funden en una sola palabra. El patrón es: partícula + l-, escritas juntas.",
          "letters": [
            "mal-",
            "tal-",
            "sal-",
            "ġol-",
            "bil-",
            "fil-",
            "lill-",
            "bħall-",
            "għall-",
            "mill-"
          ],
          "examples": [
            {
              "mt": "ma' + l-kelb → mal-kelb",
              "en": "con el perro"
            },
            {
              "mt": "ġo + l-ġnien → ġol-ġnien",
              "en": "en el jardín"
            },
            {
              "mt": "bi + l-butir → bil-butir",
              "en": "con la mantequilla"
            },
            {
              "mt": "fi + l-lift → fil-lift",
              "en": "en el ascensor"
            },
            {
              "mt": "minn + l-ħanut → mill-ħanut",
              "en": "desde la tienda"
            },
            {
              "mt": "lil + l-kuġin → lill-kuġin",
              "en": "al primo"
            }
          ]
        },
        {
          "id": "sun-assimilation",
          "title": "Consonantes 'Xemxin' en las formas fusionadas",
          "explanation": "Las formas fusionadas siguen también la regla de las consonantes 'Xemxin' de la Lección 1. Ante una consonante 'Xemxin' (ċ, d, n, r, s, t, x, ż, z), la L de la partícula fusionada cambia para igualar a la siguiente letra.",
          "letters": [
            "ċ",
            "d",
            "n",
            "r",
            "s",
            "t",
            "x",
            "ż",
            "z"
          ],
          "examples": [
            {
              "mt": "fil-xemx → fix-xemx",
              "en": "al sol"
            },
            {
              "mt": "ġol-sodda → ġos-sodda",
              "en": "en la cama"
            },
            {
              "mt": "lill-xadin → lix-xadin",
              "en": "al mono"
            },
            {
              "mt": "bħall-żunżan → bħaż-żunżan",
              "en": "como la avispa"
            },
            {
              "mt": "għall-dar → għad-dar",
              "en": "para la casa"
            },
            {
              "mt": "ta' + zija → taz-zija",
              "en": "de la tía"
            },
            {
              "mt": "fi + dar → fid-dar",
              "en": "en la casa"
            },
            {
              "mt": "ma' + ċavetta → maċ-ċavetta",
              "en": "con la llave"
            }
          ]
        },
        {
          "id": "vowel-shortening",
          "title": "Acortamiento ante vocales",
          "explanation": "Ante una vocal (o h / għ), las partículas 'bi' y 'fi' pierden su vocal y se convierten en b' / f' (obligatorio). Las partículas sa, ma' y ta' TAMBIÉN pueden acortarse — pero no es obligatorio.",
          "examples": [
