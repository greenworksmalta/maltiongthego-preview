    {
      "id": "grammar2",
      "icon": "📖",
      "title": "Grammar",
      "subtitle": "In-numri — counting, and how it bends the noun",
      "intro": "Counting in Maltese does something English never does: the number changes the noun after it. Here's how — plus first, second, third.",
      "rules": [
        {
          "id": "noun-gender",
          "title": "Every noun is a he or a she",
          "explanation": "Maltese has no 'neutral' — a table, a car, a book each counts as masculine or feminine, and that choice spreads to the words around it. Rough guide: -a tends feminine (mara, karozza); most other endings lean masculine (raġel, ktieb).",
          "examples": [
            {
              "mt": "raġel",
              "en": "man (m)"
            },
            {
              "mt": "kelb",
              "en": "dog (m)"
            },
            {
              "mt": "nannu",
              "en": "grandfather (m, -u)"
            },
            {
              "mt": "ktieb",
              "en": "book (m)"
            },
            {
              "mt": "mara",
              "en": "woman (f, -a)"
            },
            {
              "mt": "kelba",
              "en": "female dog (f, -a)"
            },
            {
              "mt": "tazza",
              "en": "glass (f, -a)"
            },
            {
              "mt": "karozza",
              "en": "car (f, -a)"
            }
          ]
        },
        {
          "id": "adjective-agreement",
          "title": "Describing words change to match",
          "explanation": "An adjective copies its noun: plain for a he-noun, +a for a she-noun, a reshaped plural for many. Tall → raġel twil / mara twila / tfal twal. And it sits after the noun, not before.",
          "examples": [
            {
              "mt": "raġel twil",
              "en": "a tall man (m)"
            },
            {
              "mt": "mara twila",
              "en": "a tall woman (f)"
            },
            {
              "mt": "tfal twal",
              "en": "tall children (pl)"
            },
            {
              "mt": "ktieb sabiħ",
              "en": "a beautiful book (m)"
            },
            {
              "mt": "fjura sabiħa",
              "en": "a beautiful flower (f)"
            },
            {
              "mt": "fjuri sbieħ",
              "en": "beautiful flowers (pl)"
            }
          ]
        },
        {
          "id": "colour-agreement",
          "title": "Colours match too",
          "explanation": "Colours are just adjectives: flokk abjad / mejda bajda / fniek bojod. A few borrowed from Italian (blu, roża, vjola, kannella) never change — easy wins.",
          "letters": [
            "Abjad/Bajda/Bojod",
            "Iswed/Sewda/Suwed",
            "Aħmar/Ħamra/Ħomor",
            "Isfar/Safra/Sofor",
            "Aħdar/Ħadra/Ħodor"
          ],
          "examples": [
            {
              "mt": "flokk abjad",
              "en": "a white t-shirt (m)"
            },
            {
              "mt": "mejda bajda",
              "en": "a white table (f)"
            },
            {
              "mt": "fniek bojod",
              "en": "white rabbits (pl)"
            },
            {
              "mt": "vann aħmar",
              "en": "a red van (m)"
            },
            {
              "mt": "zalza ħamra",
              "en": "red sauce (f)"
            },
            {
              "mt": "għasafar ħomor",
              "en": "red birds (pl)"
            },
            {
              "mt": "ġakketta blu",
              "en": "a blue jacket — blu doesn't change"
            }
          ]
        },
        {
          "id": "numbers-noun-rule",
          "title": "Counting has two gears",
          "explanation": "Maltese shifts gear as you count, and three things follow the number. 'Two' before a noun is żewġ, not tnejn (żewġ pastizzi). The numbers 3–10 slim down — tlieta→tliet, ħamsa→ħames, għaxra→għaxar — and the noun goes plural (tliet snin, three years). From 11 up the number links on with -il and the noun flips back to singular (ħdax-il sena, eleven years). Compare għaxar snin (10 years, plural) with tlieta u għoxrin sena (23 years, singular) — English never does this, so give it a few reps.",
          "examples": [
            {
              "mt": "Għandi tliet snin",
              "en": "I am 3 years old (3 + plural noun)"
            },
            {
              "mt": "Għandi għaxar snin",
              "en": "I am 10 years old (10 + plural noun)"
            },
            {
              "mt": "Għandi tlieta u għoxrin sena",
              "en": "I am 23 years old (23 + singular noun)"
            },
            {
              "mt": "Għandi ħamsa u ħamsin sena",
              "en": "I am 55 years old (55 + singular noun)"
            }
          ]
        },
        {
          "id": "ordinals",
          "title": "Putting things in order",
          "explanation": "First, second, third always travel with 'the': l-ewwel, it-tieni, it-tielet. Past tenth, just use the plain number with 'the' (il-wieħed u għoxrin = 21st).",
          "letters": [
            "L-ewwel",
            "It-tieni",
            "It-tielet",
            "Ir-raba'",
            "Il-ħames",
            "Is-sitt",
            "Is-seba'",
            "It-tmien",
            "Id-disa'",
            "L-għaxar"
          ],
          "examples": [
            {
              "mt": "L-ewwel ġurnata",
              "en": "The first day"
            },
            {
              "mt": "It-tieni triq fuq il-lemin",
              "en": "The second street on the right"
            },
            {
              "mt": "Fl-eżami ġejt il-wieħed u għoxrin",
              "en": "In the exam, I came 21st"
            }
          ]
        }
      ]
    }
  ]
