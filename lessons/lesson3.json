    {
      "id": "grammar3",
      "icon": "📖",
      "title": "Grammar",
      "subtitle": "Il-grammatika — the grammar of Lesson 3",
      "intro": "Pronouns, demonstratives and the syllable-splitting rules from the slides.",
      "rules": [
        {
          "id": "personal-pronouns",
          "title": "Personal pronouns — replace nouns",
          "explanation": "Personal pronouns (Jien, Int, Hu, Hi, Aħna, Intom, Huma) replace a noun. Hu/Huwa = he OR it (masculine); Hi/Hija = she OR it (feminine). Things and animals also get gender — a clock (arloġġ) is 'hu' because it's masculine.",
          "letters": [
            "Jien",
            "Int",
            "Hu",
            "Hi",
            "Aħna",
            "Intom",
            "Huma"
          ],
          "examples": [
            {
              "mt": "Jack imur il-futbol → Hu jmur il-futbol",
              "en": "Jack goes to football → He goes to football"
            },
            {
              "mt": "Julia għandha pupa → Hi għandha pupa",
              "en": "Julia has a doll → She has a doll"
            },
            {
              "mt": "It-tfal raqdu → Huma raqdu",
              "en": "The children slept → They slept"
            },
            {
              "mt": "L-arloġġ kbir → Hu kbir",
              "en": "The clock is big → It (m) is big"
            },
            {
              "mt": "Il-fjura safra → Hi safra",
              "en": "The flower is yellow → It (f) is yellow"
            },
            {
              "mt": "Il-karozzi sbieħ → Huma sbieħ",
              "en": "The cars are beautiful → They are beautiful"
            }
          ]
        },
        {
          "id": "demonstratives-close",
          "title": "Demonstratives — close: dan, din, dawn",
          "explanation": "When pointing to something near, use dan (m), din (f), dawn (pl). The form has to match the noun's gender and number.",
          "letters": [
            "Dan (m)",
            "Din (f)",
            "Dawn (pl)"
          ],
          "examples": [
            {
              "mt": "Dan ir-raġel",
              "en": "This man (m sing)"
            },
            {
              "mt": "Din il-mara",
              "en": "This woman (f sing)"
            },
            {
              "mt": "Dan l-arloġġ",
              "en": "This clock (m sing)"
            },
            {
              "mt": "Din iċ-ċavetta",
              "en": "This key (f sing)"
            },
            {
              "mt": "Dawn it-tfal",
              "en": "These children (pl)"
            },
            {
              "mt": "Dawn il-pasti",
              "en": "These pastries (pl)"
            }
          ]
        },
        {
          "id": "demonstratives-far",
          "title": "Demonstratives — far: dak, dik, dawk",
          "explanation": "When pointing to something further away, use dak (m), dik (f), dawk (pl). Same agreement rules as the close forms.",
          "letters": [
            "Dak (m)",
            "Dik (f)",
            "Dawk (pl)"
          ],
          "examples": [
            {
              "mt": "Dak ir-raġel",
              "en": "That man (m sing)"
            },
            {
              "mt": "Dik il-mara",
              "en": "That woman (f sing)"
            },
            {
              "mt": "Dak il-flixkun",
              "en": "That bottle (m sing)"
            },
            {
              "mt": "Dik il-larinġa",
              "en": "That orange (f sing)"
            },
            {
              "mt": "Dawk il-fjuri",
              "en": "Those flowers (pl)"
            },
            {
              "mt": "Dawk it-tfal",
              "en": "Those children (pl)"
            }
          ]
        },
        {
          "id": "syllables",
          "title": "Splitting words into syllables",
          "explanation": "Maltese has three rules. (1) Each syllable must contain exactly one vowel. (2) The second syllable must start with a consonant. (3) When two consonants sit next to each other in the middle of a word, split between them.",
          "examples": [
            {
              "mt": "ma-ra",
              "en": "mara → ma/ra (one vowel per syllable)"
            },
            {
              "mt": "ra-ġel",
              "en": "raġel → ra/ġel"
            },
            {
              "mt": "mej-da",
