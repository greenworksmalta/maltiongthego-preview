{
  "id": "u13",
  "title": "The Body, Health & a Pharmacy Visit",
  "subtitle": "Naming the body, saying what hurts, and getting what you need at the pharmacy",
  "sections": [
    {
      "id": "body13",
      "icon": "🦶",
      "title": "The body",
      "subtitle": "The parts you will need to point at",
      "intro": "Start with the words themselves. The pair forms come later in the unit, so for now just learn each one on its own.",
      "vocab": [
        {
          "mt": "ir-ras",
          "en": "the head",
          "icon": "🧠",
          "note": "Uġigħ ta' ras, a headache, is the phrase you will need most."
        },
        {
          "mt": "l-għajn",
          "en": "the eye",
          "icon": "👁️",
          "note": "The pair form għajnejn is the one you will hear most, since eyes come in twos."
        },
        {
          "mt": "il-widna",
          "en": "the ear",
          "icon": "👂",
          "note": "The pair form is widnejn. Uġigħ fil-widna is earache."
        },
        {
          "mt": "l-imnieħer",
          "en": "the nose",
          "icon": "👃",
          "note": "Written with the i: an m at the start of a word, before a consonant, is said im-."
        },
        {
          "mt": "il-ħalq",
          "en": "the mouth",
          "icon": "👄",
          "note": "Also where you point when a tooth hurts."
        },
        {
          "mt": "ix-xagħar",
          "en": "the hair",
          "icon": "🦳",
          "note": "One word for the whole head of hair, not a count of strands."
        },
        {
          "mt": "l-ispalla",
          "en": "the shoulder",
          "icon": "💪",
          "note": "Takes l- with a helping i, like l-iskola. Two shoulders is spallejn."
        },
        {
          "mt": "id-dahar",
          "en": "the back",
          "icon": "🧍",
          "note": "Plural dhur. Uġigħ ta' dahar is back pain."
        },
        {
          "mt": "is-sider",
          "en": "the chest",
          "icon": "🫁",
          "note": "Plural isdra."
        },
        {
          "mt": "iż-żaqq",
          "en": "the belly",
          "icon": "🫃",
          "note": "Plural żquq. Uġigħ ta' żaqq covers most stomach trouble."
        },
        {
          "mt": "l-id",
          "en": "the hand",
          "icon": "✋",
          "note": "There is no ordinary plural, only the pair form idejn."
        },
        {
          "mt": "il-minkeb",
          "en": "the elbow",
          "icon": "💪",
          "note": "The pair form is minkbejn."
        },
        {
          "mt": "il-polz",
          "en": "the wrist",
          "icon": "⌚",
          "note": "Also the word for a pulse."
        },
        {
          "mt": "is-saba'",
          "en": "the finger",
          "icon": "👆",
          "note": "Two fingers is subgħajn, many fingers is swaba'. Note the straight apostrophe."
        },
        {
          "mt": "id-difer",
          "en": "the nail",
          "icon": "💅",
          "note": "Two nails is difrejn, many is dwiefer."
        },
        {
          "mt": "is-sieq",
          "en": "the foot",
          "icon": "🦶",
          "note": "The pair form saqajn is used constantly. riġel is the leg."
        },
        {
          "mt": "l-irkoppa",
          "en": "the knee",
          "icon": "🦵",
          "note": "Pair form irkopptejn, plural irkoppiet."
        },
        {
          "mt": "il-ġilda",
          "en": "the skin",
          "icon": "🧴",
          "note": "No plural, it works like a substance word."
        }
      ],
