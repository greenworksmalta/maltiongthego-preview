    {
      "id": "spizerija13",
      "icon": "💊",
      "title": "At the pharmacy · a chat",
      "subtitle": "Mary describes what is wrong and is sent home to rest",
      "intro": "Every Maltese village has a pharmacy, and the pharmacist is usually the first person you ask. Listen for għandi, it carries almost every symptom in this conversation.",
      "dialogue": [
        {
          "mt": "Bonġu, kif nista' ngħinek?",
          "en": "Good morning, how can I help you?"
        },
        {
          "mt": "Bonġu. Mhux qed inħossni sew illum.",
          "en": "Good morning. I don't feel well today."
        },
        {
          "mt": "X'qed tħoss?",
          "en": "What are you feeling?"
        },
        {
          "mt": "Għandi uġigħ ta' ras u għandi d-deni.",
          "en": "I have a headache and a temperature."
        },
        {
          "mt": "Minn meta?",
          "en": "Since when?"
        },
        {
          "mt": "Mil-lbieraħ. Għandi wkoll uġigħ fil-griżmejn.",
          "en": "Since yesterday. I also have a sore throat (literal translation: pain in the tonsils)."
        },
        {
          "mt": "Qed tiekol sew? Qed torqod sew?",
          "en": "Are you eating properly? Are you sleeping properly?"
        },
        {
          "mt": "Mhux qed niekol ħafna u ma tantx qed norqod sew.",
          "en": "I'm not eating much, and I'm not really sleeping well."
        },
        {
          "mt": "Ħu din il-mediċina darbtejn kuljum, u strieħ.",
          "en": "Take this medicine twice a day, and rest."
        },
        {
          "mt": "Għandi bżonn riċetta?",
          "en": "Do I need a prescription?"
        },
        {
          "mt": "Le, m'għandekx bżonn riċetta.",
          "en": "No, you don't need a prescription."
        },
        {
          "mt": "Grazzi ħafna. Saħħa!",
          "en": "Thank you very much. Bye!"
        }
      ],
      "exercises": [
        {
          "id": "ex4",
          "type": "build",
          "max": 5,
          "items": [
            {
              "mt": "Mhux qed inħossni sew",
              "en": "I am not feeling well"
            },
            {
              "mt": "Għandi uġigħ ta' ras",
              "en": "I have a headache"
            },
            {
              "mt": "Għandi bżonn riċetta?",
              "en": "Do I need a prescription?"
            },
            {
              "mt": "Le, m'għandekx bżonn riċetta",
              "en": "No, you don't need a prescription"
            }
          ]
        }
      ]
    },
    {
      "id": "dual13",
      "icon": "👆",
      "title": "Ones, twos and manys",
      "subtitle": "Il-grammatika: the pair form",
      "intro": "Maltese counts in three steps, not two. This is the step most learners never meet, and the body is where it lives.",
      "rules": [
        {
          "id": "dual-pairs",
          "title": "Things that come in twos: the pair form",
          "explanation": "Maltese has a third number sitting between one and many, used when there are exactly two. It usually ends in -ejn or -ajn. Body parts that come as a pair almost always use it, and for some words it is the only form there is: id has no ordinary plural at all, only idejn.",
          "letters": [
            "għajn, għajnejn",
            "id, idejn",
            "sieq, saqajn",
            "spalla, spallejn",
            "minkeb, minkbejn",
            "irkoppa, irkopptejn"
          ],
          "examples": [
            {
              "mt": "Għajnejja qed juġgħuni",
              "en": "My eyes hurt"
            },
            {
              "mt": "Għandi uġigħ f'saqajja",
              "en": "My feet hurt"
            },
            {
              "mt": "Aħsel idejk",
              "en": "Wash your hands"
            }
          ]
        },
        {
          "id": "dual-time",
          "title": "The pair form is not only for the body",
          "explanation": "Units of time take it too, which is where you will meet it outside the pharmacy. Once you can hear the -ejn ending you will spot it everywhere.",
          "letters": [
            "ġurnata, ġranet",
            "jum, jumejn",
            "ġimgħa, ġimagħtejn",
            "xahar, xahrejn",
            "sena, sentejn",
            "siegħa, sagħtejn",
            "darba, darbtejn"
          ],
          "examples": [
            {
              "mt": "Ħu l-mediċina darbtejn kuljum",
              "en": "Take the medicine twice a day"
            },
            {
              "mt": "Ilni marid jumejn",
              "en": "I have been ill for two days"
            },
            {
              "mt": "Se nkun Malta għal ġimagħtejn",
              "en": "I'm going to be in Malta for two weeks"
            }
          ]
        }
      ],
      "exercises": [
        {
          "id": "g13bucket",
          "type": "bucket",
          "batch": 6,
          "title": "One or two?",
          "instructions": "Sort each word: is it one, or two?",
          "choices": [
            "One",
            "Two"
          ],
          "items": [
            {
              "word": "id",
              "answer": "One"
            },
            {
              "word": "idejn",
              "answer": "Two"
            },
            {
              "word": "sieq",
              "answer": "One"
            },
            {
              "word": "saqajn",
              "answer": "Two"
            },
            {
              "word": "ġimgħa",
              "answer": "One"
            },
            {
              "word": "ġimagħtejn",
              "answer": "Two"
            }
          ]
        }
      ]
    },
    {
      "id": "grammar13",
      "icon": "📖",
      "title": "Grammar",
      "subtitle": "Il-grammatika: saying no in the present",
      "intro": "One wrap covers both tenses, which makes this the cheapest piece of grammar in the whole app.",
      "rules": [
        {
          "id": "negative-present",
          "title": "Saying you don't: the same wrap, in the present",
          "explanation": "You already wrap the past with ma and x. The present works exactly the same way: ma before the verb, x on the end. Nifhem becomes ma nifhimx, niekol becomes ma nikolx.",
          "examples": [
            {
              "mt": "Ma nifhimx",
              "en": "I don't understand"
            },
            {
              "mt": "Ma nafx",
              "en": "I don't know"
            },
            {
              "mt": "Ma nikolx laħam",
              "en": "I don't eat meat"
            },
            {
              "mt": "Mhux qed inħossni sew",
              "en": "I am not feeling well"
            }
          ]
        },
        {
          "id": "negative-short",
          "title": "When ma shrinks to m'",
          "explanation": "Before a vowel, an għ or an h, ma drops its own vowel and joins on with an apostrophe. You have already used two of these without thinking about it: m'għandix and m'hemmx.",
          "examples": [
            {
              "mt": "M'għandix deni",
              "en": "I don't have a temperature"
            },
            {
              "mt": "M'hawnx spiżerija hawn",
              "en": "There's no pharmacy here"
            },
            {
              "mt": "M'għandekx bżonn riċetta",
              "en": "You don't need a prescription"
            }
          ]
        }
      ],
      "exercises": [
        {
          "id": "g13build",
          "type": "build",
          "max": 5,
          "items": [
            {
              "mt": "Ma nifhimx",
              "en": "I don't understand"
            },
            {
              "mt": "Ma nikolx laħam",
              "en": "I don't eat meat"
            },
            {
              "mt": "M'għandix deni",
              "en": "I don't have a temperature"
            },
            {
              "mt": "M'hawnx spiżerija hawn",
              "en": "There's no pharmacy here"
            }
          ]
        }
      ]
    },
