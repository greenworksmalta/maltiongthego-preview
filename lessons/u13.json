    {
      "id": "unwell13",
      "icon": "🤒",
      "title": "Feeling rough",
      "subtitle": "Symptoms, and the words on the pharmacy counter",
      "intro": "Most complaints in Maltese are built the same way: għandi, I have, followed by the thing that is wrong. Għandi riħ, għandi d-deni, għandi uġigħ ta' ras.",
      "vocab": [
        {
          "mt": "l-uġigħ",
          "en": "the pain",
          "icon": "🤕",
          "note": "Build with ta': uġigħ ta' ras, uġigħ ta' żaqq, uġigħ ta' snien."
        },
        {
          "mt": "id-deni",
          "en": "the fever",
          "icon": "🌡️",
          "note": "Għandi d-deni, I have a temperature."
        },
        {
          "mt": "is-sogħla",
          "en": "the cough",
          "icon": "😶‍🌫️",
          "note": "To cough is nisgħol."
        },
        {
          "mt": "riħ",
          "en": "a cold",
          "icon": "🤧",
          "note": "Għandi riħ, I have a cold. No article. kiesaħ is the weather being cold, not you being ill."
        },
        {
          "mt": "il-griżmejn",
          "en": "the tonsils",
          "icon": "🗣️",
          "note": "Already a pair form, so it never appears on its own."
        },
        {
          "mt": "is-sinna",
          "en": "the tooth",
          "icon": "🦷",
          "note": "Plural snien. Uġigħ ta' snien is toothache."
        },
        {
          "mt": "marid",
          "en": "ill",
          "icon": "🤒",
          "note": "Marid for a man, marida for a woman."
        },
        {
          "mt": "l-ispiżerija",
          "en": "the pharmacy",
          "icon": "💊",
          "note": "Takes l- with a helping i. Open on a village rota on Sundays."
        },
        {
          "mt": "il-mediċina",
          "en": "the medicine",
          "icon": "🧪",
          "note": "Also duwa in everyday speech."
        },
        {
          "mt": "ir-riċetta",
          "en": "the prescription",
          "icon": "📝",
          "note": "Same word as a cooking recipe."
        }
      ],
