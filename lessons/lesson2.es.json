    {
      "id": "grammar2",
      "icon": "📖",
      "title": "Gramática",
      "subtitle": "Il-grammatika — la gramática de la Lección 2",
      "intro": "Estos son los puntos gramaticales que cubren las diapositivas. Se basan en el artículo de la Lección 1 y establecen las reglas de concordancia que verás durante todo el curso.",
      "rules": [
        {
          "id": "noun-gender",
          "title": "Género de los sustantivos — masculino o femenino",
          "explanation": "Cada sustantivo en maltés es masculino (maskil) o femenino (femminil). Importa porque los adjetivos, los verbos y los demostrativos tienen que CONCORDAR con el género del sustantivo. A menudo (no siempre): los sustantivos masculinos terminan en consonante o en -u / -i; los femeninos terminan en -a.",
          "examples": [
            {"mt": "raġel", "en": "hombre (m)"},
            {"mt": "kelb", "en": "perro (m)"},
            {"mt": "nannu", "en": "abuelo (m, -u)"},
            {"mt": "ktieb", "en": "libro (m)"},
            {"mt": "mara", "en": "mujer (f, -a)"},
            {"mt": "kelba", "en": "perra (f, -a)"},
            {"mt": "tazza", "en": "vaso (f, -a)"},
            {"mt": "karozza", "en": "coche (f, -a)"}
          ]
        },
        {
          "id": "adjective-agreement",
          "title": "Concordancia del adjetivo — tres formas",
          "explanation": "La mayoría de los adjetivos malteses tienen TRES formas: masculino, femenino y plural. Tienes que igualar la forma con el sustantivo. El patrón suele ser: masculino termina en consonante; femenino añade -a; el plural toma una forma colectiva especial (a menudo con cambios vocálicos en el interior de la palabra).",
          "examples": [
            {
              "mt": "raġel twil",
              "en": "un hombre alto (m)"
            },
            {
              "mt": "mara twila",
              "en": "una mujer alta (f)"
            },
            {
              "mt": "tfal twal",
              "en": "niños altos (pl)"
            },
            {
              "mt": "ktieb sabiħ",
              "en": "un libro hermoso (m)"
            },
            {
              "mt": "fjura sabiħa",
              "en": "una flor hermosa (f)"
            },
            {
              "mt": "fjuri sbieħ",
              "en": "flores hermosas (pl)"
            }
          ]
        },
        {
          "id": "colour-agreement",
          "title": "Los colores siguen la misma concordancia",
          "explanation": "Los colores se comportan como adjetivos — tienen tres formas y concuerdan con el sustantivo. Algunos colores (blu, ċelesti, roża, vjola, oranġjo, kannella) son préstamos y no cambian de forma.",
          "letters": [
            "Abjad/Bajda/Bojod",
            "Iswed/Sewda/Suwed",
            "Aħmar/Ħamra/Ħomor",
            "Isfar/Safra/Sofor",
            "Aħdar/Ħadra/Ħodor"
          ],
          "examples": [
            {
              "mt": "flokk abjad",
              "en": "una camiseta blanca (m)"
            },
            {
              "mt": "mejda bajda",
              "en": "una mesa blanca (f)"
            },
            {
              "mt": "fniek bojod",
              "en": "conejos blancos (pl)"
            },
            {
              "mt": "vann aħmar",
              "en": "una furgoneta roja (m)"
            },
            {
              "mt": "zalza ħamra",
              "en": "salsa roja (f)"
            },
            {
              "mt": "għasafar ħomor",
              "en": "pájaros rojos (pl)"
            },
            {
              "mt": "ġakketta blu",
              "en": "una chaqueta azul — blu no cambia"
            }
          ]
        },
        {
          "id": "numbers-noun-rule",
          "title": "Números 2–10 usan plural; 11+ usa singular",
          "explanation": "Regla importante: después de los números del 2 al 10, el sustantivo va en PLURAL. Después de los números del 11 al 99, el sustantivo se queda en SINGULAR. Compara 'għaxar snin' (10 años — plural) con 'tlieta u għoxrin sena' (23 años — singular).",
          "examples": [
            {
              "mt": "Għandi tliet snin",
              "en": "Tengo 3 años (3 + sustantivo plural)"
            },
            {
              "mt": "Għandi għaxar snin",
              "en": "Tengo 10 años (10 + sustantivo plural)"
            },
            {
              "mt": "Għandi tlieta u għoxrin sena",
              "en": "Tengo 23 años (23 + sustantivo singular)"
            },
            {
              "mt": "Għandi ħamsa u ħamsin sena",
              "en": "Tengo 55 años (55 + sustantivo singular)"
            }
          ]
        },
        {
          "id": "ordinals",
          "title": "Números ordinales 1–10",
          "explanation": "Los ordinales muestran orden o rango. Se usan con el artículo definido (L-ewwel, It-tieni, etc.). Del 11 en adelante, simplemente se usa el número cardinal con el artículo definido (p. ej., il-wieħed u għoxrin = 21º).",
          "letters": [
