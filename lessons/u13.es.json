    {
      "id": "unwell13",
      "icon": "🤒",
      "title": "Encontrarse mal",
      "subtitle": "Síntomas y las palabras del mostrador de la farmacia",
      "intro": "Casi todas las molestias en maltés se dicen igual: għandi, tengo, seguido de lo que te pasa. Għandi riħ, għandi d-deni, għandi uġigħ ta' ras.",
      "vocab": [
        {
          "mt": "l-uġigħ",
          "en": "el dolor",
          "icon": "🤕",
          "note": "Se construye con ta': uġigħ ta' ras, uġigħ ta' żaqq, uġigħ ta' snien."
        },
        {
          "mt": "id-deni",
          "en": "la fiebre",
          "icon": "🌡️",
          "note": "Għandi d-deni, tengo fiebre."
        },
        {
          "mt": "is-sogħla",
          "en": "la tos",
          "icon": "😶‍🌫️",
          "note": "Toser es nisgħol."
        },
        {
          "mt": "riħ",
          "en": "un resfriado",
          "icon": "🤧",
          "note": "Għandi riħ, tengo un resfriado. Sin artículo. kiesaħ es el frío del tiempo, no estar enfermo."
        },
        {
          "mt": "il-griżmejn",
          "en": "las amígdalas",
          "icon": "🗣️",
          "note": "Ya es una forma de par, así que nunca aparece sola."
        },
        {
          "mt": "is-sinna",
          "en": "el diente",
          "icon": "🦷",
          "note": "Plural snien. Uġigħ ta' snien es dolor de muelas."
        },
        {
          "mt": "marid",
          "en": "enfermo",
          "icon": "🤒",
          "note": "Marid para un hombre, marida para una mujer."
        },
        {
          "mt": "l-ispiżerija",
          "en": "la farmacia",
          "icon": "💊",
          "note": "Lleva l- con una i de apoyo. Los domingos abren por turnos entre los pueblos."
        },
        {
          "mt": "il-mediċina",
          "en": "el medicamento",
          "icon": "🧪",
          "note": "En el habla de cada día también se dice duwa."
        },
        {
          "mt": "ir-riċetta",
          "en": "la receta",
          "icon": "📝",
          "note": "La misma palabra que una receta de cocina, igual que en español."
        }
      ],
