    {
      "id": "spizerija13",
      "icon": "💊",
      "title": "En la farmacia · una charla",
      "subtitle": "Mary cuenta lo que le pasa y la mandan a casa a descansar",
      "intro": "Cada pueblo maltés tiene su farmacia, y el farmacéutico suele ser la primera persona a quien preguntas. Fíjate en għandi: lleva casi todos los síntomas de esta conversación.",
      "dialogue": [
        {
          "mt": "Bonġu, kif nista' ngħinek?",
          "en": "Buenos días, ¿en qué puedo ayudarle?"
        },
        {
          "mt": "Bonġu. Mhux qed inħossni sew illum.",
          "en": "Buenos días. Hoy no me encuentro bien."
        },
        {
          "mt": "X'qed tħoss?",
          "en": "¿Qué siente?"
        },
        {
          "mt": "Għandi uġigħ ta' ras u għandi d-deni.",
          "en": "Tengo dolor de cabeza y fiebre."
        },
        {
          "mt": "Minn meta?",
          "en": "¿Desde cuándo?"
        },
        {
          "mt": "Mil-lbieraħ. Għandi wkoll uġigħ fil-griżmejn.",
          "en": "Desde ayer. También me duele la garganta (traducción literal: dolor en las amígdalas)."
        },
        {
          "mt": "Qed tiekol sew? Qed torqod sew?",
          "en": "¿Come bien? ¿Duerme bien?"
        },
        {
          "mt": "Mhux qed niekol ħafna u ma tantx qed norqod sew.",
          "en": "No estoy comiendo mucho, y no estoy durmiendo muy bien."
        },
        {
          "mt": "Ħu din il-mediċina darbtejn kuljum, u strieħ.",
          "en": "Tome este medicamento dos veces al día, y descanse."
        },
        {
          "mt": "Għandi bżonn riċetta?",
          "en": "¿Necesito receta?"
        },
        {
          "mt": "Le, m'għandekx bżonn riċetta.",
          "en": "No, no necesita receta."
        },
        {
          "mt": "Grazzi ħafna. Saħħa!",
          "en": "Muchas gracias. ¡Adiós!"
        }
      ],
      "exercises": [
