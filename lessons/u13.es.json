{
  "id": "u13",
  "title": "Cuerpo, Salud y Visita a la Farmacia",
  "subtitle": "Nombrar el cuerpo, decir qué duele y conseguir lo que necesitas en la farmacia",
  "lang": "es",
  "sections": [
    {
      "id": "body13",
      "icon": "🦶",
      "title": "El cuerpo",
      "subtitle": "Las partes que vas a necesitar señalar",
      "intro": "Empieza por las palabras en sí. Las formas de par llegan más adelante en la unidad, así que por ahora aprende cada una por separado.",
      "vocab": [
        {
          "mt": "ir-ras",
          "en": "la cabeza",
          "icon": "🧠",
          "note": "Uġigħ ta' ras, dolor de cabeza, es la frase que más vas a necesitar."
        },
        {
          "mt": "l-għajn",
          "en": "el ojo",
          "icon": "👁️",
          "note": "La forma de par għajnejn es la que más oirás, porque los ojos van de dos en dos."
        },
        {
          "mt": "il-widna",
          "en": "la oreja",
          "icon": "👂",
          "note": "La forma de par es widnejn. Uġigħ fil-widna es dolor de oído."
        },
        {
          "mt": "l-imnieħer",
          "en": "la nariz",
          "icon": "👃",
          "note": "Se escribe con la i: una m al principio de palabra, delante de consonante, se pronuncia im-."
        },
        {
          "mt": "il-ħalq",
          "en": "la boca",
          "icon": "👄",
          "note": "También es donde señalas cuando te duele una muela."
        },
        {
          "mt": "ix-xagħar",
          "en": "el pelo",
          "icon": "🦳",
          "note": "Una sola palabra para todo el pelo, no para contar cabellos."
        },
        {
          "mt": "l-ispalla",
          "en": "el hombro",
          "icon": "💪",
          "note": "Lleva l- con una i de apoyo, como l-iskola. Dos hombros es spallejn."
        },
        {
          "mt": "id-dahar",
          "en": "la espalda",
          "icon": "🧍",
          "note": "Plural dhur. Uġigħ ta' dahar es dolor de espalda."
        },
        {
          "mt": "is-sider",
          "en": "el pecho",
          "icon": "🫁",
          "note": "Plural isdra."
        },
        {
          "mt": "iż-żaqq",
          "en": "la barriga",
          "icon": "🫃",
          "note": "Plural żquq. Uġigħ ta' żaqq sirve para casi cualquier molestia de estómago."
        },
        {
          "mt": "l-id",
          "en": "la mano",
          "icon": "✋",
          "note": "No tiene plural normal, solo la forma de par idejn."
        },
        {
          "mt": "il-minkeb",
          "en": "el codo",
          "icon": "💪",
          "note": "La forma de par es minkbejn."
        },
        {
          "mt": "il-polz",
          "en": "la muñeca",
          "icon": "⌚",
          "note": "También es la palabra para el pulso."
        },
        {
          "mt": "is-saba'",
          "en": "el dedo",
          "icon": "👆",
          "note": "Dos dedos es subgħajn, muchos dedos es swaba'. Fíjate en el apóstrofo recto."
        },
        {
          "mt": "id-difer",
          "en": "la uña",
          "icon": "💅",
          "note": "Dos uñas es difrejn, muchas es dwiefer."
        },
        {
          "mt": "is-sieq",
          "en": "el pie",
          "icon": "🦶",
          "note": "La forma de par saqajn se usa constantemente. riġel es la pierna."
        },
        {
          "mt": "l-irkoppa",
          "en": "la rodilla",
          "icon": "🦵",
          "note": "Forma de par irkopptejn, plural irkoppiet."
        },
        {
          "mt": "il-ġilda",
          "en": "la piel",
          "icon": "🧴",
          "note": "No tiene plural, funciona como una palabra de materia."
        }
