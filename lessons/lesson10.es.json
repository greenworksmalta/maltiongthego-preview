    {
      "id": "grammar",
      "icon": "📖",
      "title": "El Artículo",
      "subtitle": "L-artiklu — decir 'el / la' en maltés",
      "intro": "El maltés tiene un solo artículo para 'el / la'. Se escribe il- o l- y se une al sustantivo con un guion. Pero la grafía cambia según la primera letra de la palabra — lee las reglas y luego prueba los ejercicios.",
      "rules": [
        {
          "id": "the-article",
          "title": "il- y l- — el artículo",
          "explanation": "El artículo maltés se forma añadiendo il- (o l-) delante de un sustantivo o adjetivo. Define el sustantivo — convierte 'una familia' en 'la familia'.",
          "examples": [
            {"mt": "il-familja", "en": "la familia (familja → il-familja)"},
            {"mt": "il-kuġin", "en": "el primo (kuġin → il-kuġin)"},
            {"mt": "il-baħar", "en": "el mar"},
            {"mt": "il-labra", "en": "la aguja"}
          ]
        },
        {
          "id": "before-vowel",
          "title": "Ante vocal — usa l-",
          "explanation": "Si la palabra empieza por vocal (a, e, i, ie, o, u) la i del artículo desaparece y se usa solo l-. Esta regla suele aplicarse también a las palabras que empiezan por għ y h.",
          "examples": [
            {"mt": "l-omm", "en": "la madre"},
            {"mt": "l-aħwa", "en": "los hermanos / las hermanas"},
            {"mt": "l-għasfur", "en": "el pájaro"},
            {"mt": "l-hena", "en": "la alegría"}
          ]
        },
        {
          "id": "sun-consonants",
          "title": "Consonantes 'Xemxin' — la l se asimila",
          "explanation": "Hay nueve consonantes 'Xemxin': ċ, d, n, r, s, t, x, ż y z. Cuando una palabra empieza por una de ellas, la l de il-/l- cambia para igualar esa consonante — es decir, se duplica.",
          "letters": ["ċ", "d", "n", "r", "s", "t", "x", "ż", "z"],
          "examples": [
            {"mt": "iċ-ċurkett", "en": "el anillo"},
            {"mt": "id-dar", "en": "la casa"},
            {"mt": "in-nar", "en": "el fuego"},
            {"mt": "ir-raġel", "en": "el hombre"},
            {"mt": "ix-xalla", "en": "la bufanda"},
            {"mt": "iż-żejt", "en": "el aceite"},
            {"mt": "iz-zokkor", "en": "el azúcar"}
          ]
        },
        {
          "id": "moon-consonants",
          "title": "Consonantes 'Qamrin' — mantienen il- o l-",
          "explanation": "Las quince consonantes 'Qamrin' — b, f, ġ, g, għ, h, ħ, j, k, l, m, p, q, v y w — NO se asimilan. Simplemente toman il- (o l- cuando la palabra empieza por vocal, għ o h).",
          "letters": ["b", "f", "ġ", "g", "għ", "h", "ħ", "j", "k", "l", "m", "p", "q", "v", "w"],
          "examples": [
            {"mt": "il-baħar", "en": "el mar"},
            {"mt": "il-ġebla", "en": "la piedra"},
            {"mt": "il-kelb", "en": "el perro"},
            {"mt": "l-arloġġ", "en": "el reloj"},
            {"mt": "l-għaġin", "en": "la pasta"}
          ]
        },
        {
          "id": "vowel-before",
          "title": "Una vocal antes del artículo — elimina la i",
          "explanation": "Cuando la palabra anterior al artículo termina una frase con vocal, la i del artículo desaparece: 'Mort nixtri iċ-ċurkett' se convierte en 'Mort nixtri ċ-ċurkett'.",
          "examples": [
            {"mt": "Mort nixtri ċ-ċurkett", "en": "Fui a comprar el anillo"},
            {"mt": "Jien inħobb ħafna x-xemx", "en": "Me encanta mucho el sol"}
          ]
        }
      ],
      "exercises": [
        {
          "id": "ex3",
          "title": "Consonantes 'Xemxin' — elige el artículo",
          "instructions": "Elige el artículo que corresponde a la primera letra de la palabra.",
          "choices": ["iċ-", "id-", "in-", "ir-", "is-", "it-", "ix-", "iż-"],
          "items": [
            {"word": "ċavetta", "answer": "iċ-", "en": "la llave"},
            {"word": "dar", "answer": "id-", "en": "la casa"},
            {"word": "nar", "answer": "in-", "en": "el fuego"},
            {"word": "raġel", "answer": "ir-", "en": "el hombre"},
            {"word": "serp", "answer": "is-", "en": "la serpiente"},
            {"word": "tifel", "answer": "it-", "en": "el niño"},
            {"word": "xemx", "answer": "ix-", "en": "el sol"},
            {"word": "żunżana", "answer": "iż-", "en": "la avispa"},
            {"word": "ċurkett", "answer": "iċ-", "en": "el anillo"},
            {"word": "triq", "answer": "it-", "en": "la calle"}
          ]
        },
        {
          "id": "ex4",
          "title": "Consonantes 'Qamrin' — ¿il- o l-?",
          "instructions": "Las consonantes 'Qamrin' mantienen il-; usa l- solo cuando la palabra empieza por vocal, għ o h.",
          "choices": ["il-", "l-"],
          "items": [
            {"word": "baħar", "answer": "il-", "en": "el mar"},
            {"word": "labra", "answer": "il-", "en": "la aguja"},
            {"word": "ġebla", "answer": "il-", "en": "la piedra"},
            {"word": "qattus", "answer": "il-", "en": "el gato"},
            {"word": "ħuta", "answer": "il-", "en": "el pez"},
            {"word": "kelb", "answer": "il-", "en": "el perro"},
            {"word": "arloġġ", "answer": "l-", "en": "el reloj"},
            {"word": "għaġin", "answer": "l-", "en": "la pasta"},
            {"word": "ors", "answer": "l-", "en": "el oso"},
            {"word": "iljun", "answer": "l-", "en": "el león"}
          ]
        },
        {
          "id": "ex5",
          "title": "Mixto — elige el artículo",
          "instructions": "¿'Xemxin' o 'Qamrin'? Elige el artículo correcto para cada palabra.",
          "choices": ["il-", "l-", "iċ-", "id-", "in-", "ir-", "is-", "ix-", "iż-"],
          "items": [
            {"word": "omm", "answer": "l-", "en": "la madre"},
            {"word": "dar", "answer": "id-", "en": "la casa"},
            {"word": "ċurkett", "answer": "iċ-", "en": "el anillo"},
            {"word": "baħar", "answer": "il-", "en": "el mar"},
            {"word": "nar", "answer": "in-", "en": "el fuego"},
            {"word": "raġel", "answer": "ir-", "en": "el hombre"},
            {"word": "xemx", "answer": "ix-", "en": "el sol"},
            {"word": "żejt", "answer": "iż-", "en": "el aceite"},
            {"word": "siġra", "answer": "is-", "en": "el árbol"},
            {"word": "għasfur", "answer": "l-", "en": "el pájaro"}
          ]
        }
      ]
    },
