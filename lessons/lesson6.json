    {
      "id": "grammar6",
      "icon": "📖",
      "title": "Grammar",
      "subtitle": "Il-grammatika — the grammar of Lesson 6",
      "intro": "The 8 Wh-question words and the two models for verbs with the letter għ in the present tense.",
      "rules": [
        {
          "id": "wh-questions",
          "title": "The 8 Wh-question words",
          "explanation": "These are the question starters you need for asking just about anything. Each one introduces a question, and most are placed at the start of the sentence.",
          "letters": [
            "Min?",
            "Fejn?",
            "Xi?/Xiex?",
            "Għaliex?/Għala?",
            "Meta?",
            "Liema?",
            "Ta' min?",
            "Kif?"
          ],
          "examples": [
            {
              "mt": "Min hu l-missierek?",
              "en": "Who is your father?"
            },
            {
              "mt": "Fejn mort?",
              "en": "Where did you go?"
            },
            {
              "mt": "Xi tfisser din il-kelma?",
              "en": "What does this word mean?"
            },
            {
              "mt": "Għaliex kissirt it-tazza?",
              "en": "Why did you break the glass?"
            },
            {
              "mt": "Meta sejrin nixtru?",
              "en": "When are we going shopping?"
            },
            {
              "mt": "Liema hi l-isbaħ libsa?",
              "en": "Which of these dresses is the nicest?"
            },
            {
              "mt": "Ta' min hu dan il-lapes?",
              "en": "Whose pencil is this?"
            },
            {
              "mt": "Kif se naslu fil-ħin?",
              "en": "How are we going to arrive on time?"
            }
          ]
        },
        {
          "id": "ghpresent-rifes",
          "title": "Verbs with għ at the start — model 'Rifes'",
          "explanation": "When a verb starts with għ, conjugate it on the model 'Rifes' (already in the present). Wherever you see 'R' in Rifes, write 'għ' in your verb. This trick keeps the spelling regular even when the għ is hard to hear.",
          "letters": [
            "niRfes / tiRfes / jiRfes / tiRfes / niRfsu / tiRfsu / jiRfsu"
          ],
