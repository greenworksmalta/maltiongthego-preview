      "id": "ghpresent",
      "icon": "⏮️",
      "title": "The Past Tense",
      "subtitle": "Il-passat — talking about yesterday",
      "intro": "The past tense is built on the mamma — the plain 'he' form, the answer to 'Hu x'għamel ilbieraħ?' (What did he do yesterday?). You add a suffix for each person: Jien -t, Int -t, Hu (no change), Hi -et, Aħna -na, Intom -tu, Huma -u. The three root consonants stay put while the vowels shift around them. Study the tables, then try the exercises.",
      "rules": [
        {
          "id": "kiteb",
          "title": "Kiteb — to write (root k-t-b)",
          "rows": [
            {"person": "Jien", "pronoun": "Jien", "form": "ktibt", "en": "I wrote"},
            {"person": "Int", "pronoun": "Int", "form": "ktibt", "en": "you wrote"},
            {"person": "Hu", "pronoun": "Hu", "form": "kiteb", "en": "he wrote (mamma)"},
            {"person": "Hi", "pronoun": "Hi", "form": "kitbet", "en": "she wrote"},
            {"person": "Aħna", "pronoun": "Aħna", "form": "ktibna", "en": "we wrote"},
            {"person": "Intom", "pronoun": "Intom", "form": "ktibtu", "en": "you (pl) wrote"},
            {"person": "Huma", "pronoun": "Huma", "form": "kitbu", "en": "they wrote"}
          ]
        },
        {
          "id": "raqad",
          "title": "Raqad — to sleep (root r-q-d)",
          "rows": [
            {"person": "Jien", "pronoun": "Jien", "form": "rqadt", "en": "I slept"},
            {"person": "Int", "pronoun": "Int", "form": "rqadt", "en": "you slept"},
            {"person": "Hu", "pronoun": "Hu", "form": "raqad", "en": "he slept (mamma)"},
            {"person": "Hi", "pronoun": "Hi", "form": "raqdet", "en": "she slept"},
            {"person": "Aħna", "pronoun": "Aħna", "form": "rqadna", "en": "we slept"},
            {"person": "Intom", "pronoun": "Intom", "form": "rqadtu", "en": "you (pl) slept"},
            {"person": "Huma", "pronoun": "Huma", "form": "raqdu", "en": "they slept"}
          ]
        },
        {
          "id": "hareg",
          "title": "Ħareġ — to go out (root ħ-r-ġ)",
          "rows": [
            {"person": "Jien", "pronoun": "Jien", "form": "ħriġt", "en": "I went out"},
            {"person": "Int", "pronoun": "Int", "form": "ħriġt", "en": "you went out"},
            {"person": "Hu", "pronoun": "Hu", "form": "ħareġ", "en": "he went out (mamma)"},
            {"person": "Hi", "pronoun": "Hi", "form": "ħarġet", "en": "she went out"},
            {"person": "Aħna", "pronoun": "Aħna", "form": "ħriġna", "en": "we went out"},
            {"person": "Intom", "pronoun": "Intom", "form": "ħriġtu", "en": "you (pl) went out"},
            {"person": "Huma", "pronoun": "Huma", "form": "ħarġu", "en": "they went out"}
          ]
        },
        {
          "id": "mar",
          "title": "Mar — to go (irregular, weak root m-w-r)",
          "rows": [
            {"person": "Jien", "pronoun": "Jien", "form": "mort", "en": "I went"},
            {"person": "Int", "pronoun": "Int", "form": "mort", "en": "you went"},
            {"person": "Hu", "pronoun": "Hu", "form": "mar", "en": "he went (mamma)"},
            {"person": "Hi", "pronoun": "Hi", "form": "marret", "en": "she went"},
            {"person": "Aħna", "pronoun": "Aħna", "form": "morna", "en": "we went"},
            {"person": "Intom", "pronoun": "Intom", "form": "mortu", "en": "you (pl) went"},
            {"person": "Huma", "pronoun": "Huma", "form": "marru", "en": "they went"}
          ]
        }
      ],
      "exercises": [
        {
          "id": "ex5",
          "title": "Conjugate kiteb (to write) in the past",
          "instructions": "Pick the correct past-tense form for each pronoun.",
          "choices": ["ktibt", "kiteb", "kitbet", "ktibna", "ktibtu", "kitbu"],
          "items": [
            {"pronoun": "Jien", "en": "I wrote", "answer": "ktibt"},
            {"pronoun": "Int", "en": "You wrote", "answer": "ktibt"},
            {"pronoun": "Hu", "en": "He wrote", "answer": "kiteb"},
            {"pronoun": "Hi", "en": "She wrote", "answer": "kitbet"},
            {"pronoun": "Aħna", "en": "We wrote", "answer": "ktibna"},
            {"pronoun": "Intom", "en": "You (pl) wrote", "answer": "ktibtu"},
            {"pronoun": "Huma", "en": "They wrote", "answer": "kitbu"}
          ]
        },
        {
          "id": "ex6",
          "title": "Choose the correct verb",
          "instructions": "Pick the past-tense verb that fits each sentence.",
          "choices": ["rqadt", "ħareġ", "marret", "telqu", "ktibt", "rkibt", "dħalna", "ħdimtu"],
          "items": [
            {"sentence": "Jien ___ tard.", "en": "I slept late. (raqad)", "answer": "rqadt"},
            {"sentence": "Hu ___ kmieni.", "en": "He went out early. (ħareġ)", "answer": "ħareġ"},
            {"sentence": "Hi ___ fil-ħin.", "en": "She went on time. (mar)", "answer": "marret"},
            {"sentence": "Huma ___ jiġru.", "en": "They left running. (telaq)", "answer": "telqu"},
            {"sentence": "Jien ___ ittra.", "en": "I wrote a letter. (kiteb)", "answer": "ktibt"},
            {"sentence": "Int ___ tal-linja.", "en": "You rode the bus. (rikeb)", "answer": "rkibt"},
            {"sentence": "Aħna ___ ġo kamra kbira.", "en": "We entered a big room. (daħal)", "answer": "dħalna"},
            {"sentence": "Intom ___ ħafna.", "en": "You (pl) worked a lot. (ħadem)", "answer": "ħdimtu"}
          ]
        }
      ]
