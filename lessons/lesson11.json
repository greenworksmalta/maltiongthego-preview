    {
      "id": "grammar11",
      "icon": "📝",
      "title": "Grammar",
      "subtitle": "Il-grammatika — the grammar of Lesson 11",
      "intro": "The past tense explained — the mamma, the suffixes, the root, and irregular verbs.",
      "rules": [
        {
          "id": "mamma-suffixes",
          "title": "The mamma and the seven suffixes",
          "explanation": "The past tense is built on the mamma — the bare 'he' form. To it you add a suffix for each person. Hu takes no suffix at all (it IS the mamma).",
          "letters": ["Jien -t", "Int -t", "Hu —", "Hi -et", "Aħna -na", "Intom -tu", "Huma -u"],
          "examples": [
            {"mt": "Hu kiteb", "en": "He wrote — the mamma, no suffix"},
            {"mt": "Jien ktibt", "en": "I wrote — mamma + -t"},
            {"mt": "Hi kitbet", "en": "She wrote — mamma + -et"},
            {"mt": "Huma kitbu", "en": "They wrote — mamma + -u"}
          ]
        },
        {
          "id": "root-vowel",
          "title": "The root and the changing vowel",
          "explanation": "Most Maltese verbs sit on a three-consonant root. In kiteb the root is k-t-b. When you add suffixes, those three consonants stay fixed but the vowels around them shift — this root-and-pattern system is inherited from Arabic and is typical of Semitic languages.",
          "examples": [
            {"mt": "kiteb — ktibt — kitbet — kitbu", "en": "to write: the k-t-b root stays, the vowels move"},
            {"mt": "ħareġ — ħriġt — ħarġet", "en": "to go out: the ħ-r-ġ root stays"}
          ]
        },
        {
          "id": "weak-roots",
          "title": "Weak roots — irregular verbs",
          "explanation": "Some verbs have a 'weak letter' in the root — in Maltese, l-għerq dgħajjef. The verb mar (to go) has the root m-w-r; the w is weak and disappears or transforms when suffixes are added, so the verb changes shape quite dramatically.",
          "examples": [
            {"mt": "mar — mort", "en": "he went — I went"},
            {"mt": "marret — morna — marru", "en": "she went — we went — they went"}
          ]
        }
      ]
    }
