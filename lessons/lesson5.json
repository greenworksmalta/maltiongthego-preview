    {
      "id": "grammar5",
      "icon": "📖",
      "title": "Grammar",
      "subtitle": "Il-grammatika — the grammar of Lesson 5",
      "intro": "Three big patterns: the singular/collective/plural for fruit & veg, the imperative, and how the present tense is built from the imperative.",
      "rules": [
        {
          "id": "sing-coll-plural",
          "title": "Singular vs collective vs plural",
