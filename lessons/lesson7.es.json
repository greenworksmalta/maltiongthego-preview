          "mt": "Se nibqa' nirrilassa d-dar",
          "en": "Voy a relajarme en casa"
        }
      ],
      "dialogue": [
        {
          "mt": "X'għandek pjanijiet dan il-weekend?",
          "en": "¿Qué planes tienes para el fin de semana?"
        },
        {
          "mt": "Nhar is-Sibt sejra Kemmuna bil-vapur.",
          "en": "El sábado voy a Comino en ferry."
        },
        {
          "mt": "U nhar il-Ħadd?",
          "en": "¿Y el domingo?"
        },
        {
          "mt": "Se nibqa' d-dar, naqra ftit u norqod kmieni.",
          "en": "Me quedo en casa — leo un poco y me duermo temprano."
        }
      ]
    },
