    {
      "id": "grammar7",
      "icon": "📖",
      "title": "Gramática",
      "subtitle": "Il-grammatika — la gramática de la Lección 7",
      "intro": "Estos son los puntos gramaticales cubiertos en las diapositivas. Cada regla tiene ejemplos sacados de la lección.",
      "rules": [
        {
          "id": "future-se",
          "title": "Futuro con 'Se' + verbo",
