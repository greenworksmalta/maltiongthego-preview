    {
      "id": "transport12",
      "icon": "🚊",
      "title": "Getting around",
      "subtitle": "How Malta got around, then and now",
      "intro": "From a mule and two wooden wheels to the buses and ferries you use today.",
      "vocab": [
        {
          "mt": "il-kaless",
          "en": "the caleche",
          "icon": "🐴",
          "note": "Two big wooden wheels and one mule or horse. The driver walked alongside."
        },
        {
          "mt": "il-karozzin",
          "en": "the horse-drawn carriage",
          "icon": "🎠",
          "note": "From 1856. Enclosed and sprung, and this time the driver could sit."
        },
        {
          "mt": "l-omnibus",
          "en": "the omnibus",
          "icon": "🚋",
          "note": "Malta's first public transport: three horses, twenty-two passengers."
        },
