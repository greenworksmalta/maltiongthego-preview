          "mt": "il-ferrovija",
          "en": "the railway",
          "icon": "🚂",
          "note": "Valletta to Mdina, from 1883 until it closed in 1931."
        },
        {
          "mt": "it-tramm",
          "en": "the tram",
          "icon": "🚊",
          "note": "From 1905, with an upper and a lower deck."
        },
        {
          "mt": "il-karozza tal-linja",
          "en": "the bus",
          "icon": "🚌",
          "note": "Owners once painted their own buses; today's service began in 2014."
