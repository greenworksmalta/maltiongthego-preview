{
  "id": "u12",
  "title": "Old Malta",
  "subtitle": "Old shops, old ways of getting around, and how to talk about the past",
  "sections": [
    {
      "id": "shops12",
      "icon": "🏪",
      "title": "Old shops",
      "subtitle": "Old shops and the trades behind them",
      "intro": "Every village had these. Most of the trades have gone, but the words are still on shop signs and street names.",
      "vocab": [
        {
          "mt": "il-barbier",
          "en": "the barber",
          "icon": "💈",
          "note": "He shaved customers too, and the shop was where village news travelled."
        },
        {
          "mt": "il-furnar",
          "en": "the baker",
          "icon": "🥖",
          "note": "Families brought their own dough to be baked."
        },
        {
          "mt": "il-ħajjat",
          "en": "the tailor",
          "icon": "🧵",
          "note": "Clothes were mended and altered, not replaced."
        },
        {
          "mt": "l-iskarpan",
          "en": "the cobbler",
          "icon": "👞",
          "note": "Repaired shoes until cheap factory-made footwear arrived."
        },
        {
          "mt": "il-ħaddied",
          "en": "the blacksmith",
          "icon": "🔨",
          "note": "Worked iron for tools and things around the house."
        },
        {
          "mt": "il-ħanut tal-merċa",
          "en": "the grocery shop",
          "icon": "🛒",
          "note": "Sold loose goods, weighed out for you, not packets."
        },
        {
          "mt": "il-ħanut tal-ħelu",
          "en": "the sweet shop",
          "icon": "🍬",
          "note": "Small, family-run, and beloved by children."
        },
        {
          "mt": "il-ħanut tal-gazzetti",
          "en": "the newsagent",
          "icon": "📰",
          "note": "Newspapers and magazines, local and foreign."
        },
        {
          "mt": "il-ħanut tat-te",
          "en": "the tea shop",
          "icon": "☕",
          "note": "Somewhere to sit, talk and drink; a social place more than a shop."
        }
      ],
