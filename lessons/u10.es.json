    {
      "id": "grammar10",
      "icon": "📖",
      "title": "Gramática",
      "subtitle": "Il-grammatika: usar el pasado",
      "intro": "Dos cosas que hacen útil el pasado: decir que NO hiciste algo, y decir CUÁNDO.",
      "rules": [
        {
          "id": "negative-past",
          "title": "Decir que no: el envoltorio ma...x",
          "explanation": "Para hacer el pasado negativo, envuelve el verbo: pon 'ma' delante y 'x' al final. Ħdimt (yo trabajé) se convierte en ma ħdimtx (yo no trabajé).",
          "examples": [
            {
              "mt": "Ma ħdimtx illum",
              "en": "Hoy no trabajé"
            },
            {
              "mt": "Ma kiltx il-fenek",
              "en": "No me comí el conejo"
            },
            {
              "mt": "Ma mortx ix-xogħol",
              "en": "No fui al trabajo"
            },
            {
              "mt": "M'għamilt xejn",
              "en": "No hice nada"
            }
          ]
        },
        {
          "id": "time-words",
          "title": "Decir cuándo: ayer, la semana pasada",
          "explanation": "Ancla el pasado con una palabra de tiempo, normalmente al principio o al final de la frase.",
          "letters": [
            "ilbieraħ, yesterday",
            "illum, today",
            "il-ġimgħa l-oħra, last week",
            "is-sena l-oħra, last year"
          ],
          "examples": [
            {
              "mt": "Ilbieraħ mort Malta",
              "en": "Ayer fui a Malta"
            },
            {
              "mt": "Il-ġimgħa l-oħra ħdimt ħafna",
              "en": "La semana pasada trabajé mucho"
            },
            {
              "mt": "Is-sena l-oħra mort Għawdex",
              "en": "El año pasado fui a Gozo"
            }
          ]
        }
      ],
      "exercises": [
        {
          "id": "g10build",
          "type": "build",
          "max": 5,
          "title": "Construye la frase",
          "items": [
            {
              "mt": "Ilbieraħ mort id-dar",
              "en": "Ayer fui a casa"
