    {
      "id": "grammar4",
      "icon": "📖",
      "title": "Gramática",
      "subtitle": "Il-grammatika — la gramática de la Lección 4",
      "intro": "Dos formas de mostrar 'de quién': la palabra ta', y los pronombres pegados.",
      "rules": [
        {
          "id": "ta-possessive",
          "title": "Posesivo con ta' (de)",
          "explanation": "La forma más sencilla de mostrar posesión: sustantivo + ta' + dueño. Literalmente 'X de Y'. Usa 'ta'' para cualquier dueño — nombres, familiares, cosas.",
          "examples": [
            {
              "mt": "Il-kelb ta' Matthew",
              "en": "El perro de Matthew"
            },
            {
              "mt": "Il-pupa ta' Sarah",
              "en": "La muñeca de Sarah"
            },
            {
              "mt": "Il-ktieb ta' Sean",
              "en": "El libro de Sean"
            },
            {
              "mt": "Il-basket ta' Maria",
              "en": "El bolso de Maria"
            },
            {
              "mt": "Ir-rota ta' Jessica",
              "en": "La bicicleta de Jessica"
            },
            {
              "mt": "It-tfal ta' Marika",
              "en": "Los hijos de Marika"
            }
          ]
        },
        {
          "id": "possessive-pronouns",
          "title": "Pronombres posesivos — tiegħi, tiegħek, tiegħu…",
          "explanation": "Cuando el dueño es un pronombre (mi, tu, su…), usa una de estas palabras independientes DESPUÉS del sustantivo. Concuerdan con el DUEÑO, no con el sustantivo.",
          "letters": [
            "Tiegħi",
            "Tiegħek",
            "Tiegħu",
            "Tagħha",
            "Tagħna",
            "Tagħkom",
            "Tagħhom"
          ],
          "examples": [
            {
              "mt": "Il-kelb tiegħi",
              "en": "Mi perro"
            },
            {
              "mt": "Il-kelb tiegħek",
              "en": "Tu perro"
            },
            {
              "mt": "Il-kelb tiegħu",
              "en": "Su perro (de él)"
            },
            {
              "mt": "Il-kelb tagħha",
              "en": "Su perro (de ella)"
            },
            {
              "mt": "Il-kelb tagħna",
              "en": "Nuestro perro"
            },
            {
              "mt": "Il-kelb tagħkom",
              "en": "Vuestro perro"
            },
            {
              "mt": "Il-kelb tagħhom",
              "en": "Su perro (de ellos)"
            }
          ]
        },
        {
          "id": "attached-pronouns",
          "title": "Pronombres pegados — sufijo directo al sustantivo",
          "explanation": "En vez de 'dar tiegħi' (mi casa), el maltés muchas veces pega un pequeño sufijo al sustantivo: dari. Los sufijos son -i (mi), -ek (tu), -u (su m), -ha (su f), -na (nuestro), -kom (vuestro), -hom (su pl). El artículo desaparece.",
          "letters": [
            "-i (mi)",
            "-ek (tu)",
            "-u (su m)",
            "-ha (su f)",
            "-na (nuestro)",
            "-kom (vuestro)",
            "-hom (su pl)"
          ],
          "examples": [
            {
              "mt": "dar tiegħi → dari",
              "en": "mi casa"
            },
            {
              "mt": "dar tiegħek → darek",
              "en": "tu casa"
            },
            {
              "mt": "dar tiegħu → daru",
              "en": "su casa (de él)"
            },
            {
              "mt": "missier tagħha → missierha",
              "en": "su padre (de ella)"
            },
            {
              "mt": "missier tagħna → missierna",
              "en": "nuestro padre"
            },
            {
              "mt": "qalb tiegħi → qalbi",
              "en": "mi corazón"
            },
            {
              "mt": "art tagħhom → arthom",
              "en": "su tierra (de ellos)"
            }
          ]
        },
        {
          "id": "family-plurals",
          "title": "Los plurales familiares son irregulares",
          "explanation": "Los plurales de los miembros de la familia no siguen un único patrón — muchos toman -ijiet o -iet, algunos son completamente distintos. Memoriza las parejas.",
