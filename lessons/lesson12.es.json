        {"mt": "il-ħajjata", "en": "la costurera — cosía, remendaba y bordaba la ropa a mano"},
        {"mt": "l-iskarpan", "en": "el zapatero — remendaba zapatos gastados y artículos de cuero"},
        {"mt": "il-ħaddied", "en": "el herrero — forjaba y reparaba herramientas, verjas y objetos de hierro a mano"},
        {"mt": "ħanut tal-merċa", "en": "la tienda de comestibles — una pequeña tienda familiar de comida diaria"},
        {"mt": "ħanut tal-ħelu", "en": "la dulcería — dulces y golosinas malteses tradicionales"},
        {"mt": "ħanut tal-gazzetti", "en": "el quiosco de prensa — periódicos y revistas"}
      ]
