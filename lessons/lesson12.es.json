    {
      "id": "grammar12",
      "icon": "📝",
      "title": "Gramática",
      "subtitle": "Il-grammatika — la gramática de la Lección 12",
      "intro": "El pasado otra vez — un repaso rápido, y luego el comportamiento especial de los verbos cuya raíz contiene għ.",
      "rules": [
        {
          "id": "past-recap",
          "title": "El pasado — repaso rápido",
          "explanation": "El pasado es la mamma (la forma desnuda de 'él') más un sufijo personal. Hu no lleva sufijo. Las tres consonantes de la raíz se quedan fijas mientras las vocales se desplazan.",
          "letters": ["Jien -t", "Int -t", "Hu —", "Hi -et", "Aħna -na", "Intom -tu", "Huma -u"],
          "examples": [
            {"mt": "Hu għamel", "en": "Él hizo — la mamma"},
            {"mt": "Jien għamilt", "en": "Yo hice — mamma + -t"},
            {"mt": "Huma għamlu", "en": "Ellos hicieron — mamma + -u"}
          ]
        },
        {
          "id": "gh-at-start",
          "title": "għ al principio de la raíz",
          "explanation": "Cuando għ es la primera letra de la raíz — como en għamel (raíz għ-m-l) y għażel (raíz għ-ż-l) — el għ se queda delante durante toda la conjugación; solo se mueven las vocales que le siguen.",
          "examples": [
            {"mt": "għamel — għamilt — għamlet", "en": "hacer: él / yo / ella hizo"},
            {"mt": "għażel — għażilt — għażlu", "en": "elegir: él / yo elegí — ellos eligieron"}
          ]
        },
        {
          "id": "gh-in-middle",
          "title": "għ en el medio de la raíz",
          "explanation": "Cuando għ está en el medio de la raíz — como en lagħab (raíz l-għ-b) y xegħel (raíz x-għ-l) — el verbo cambia de forma más notoriamente. En las formas yo / tú / nosotros la primera vocal desaparece: lagħab → lgħabt, xegħel → xgħelt.",
          "examples": [
            {"mt": "lagħab — lgħabt — lagħbet", "en": "jugar: él / yo / ella jugó"},
            {"mt": "xegħel — xgħelt — xegħlu", "en": "encender: él / yo encendí — ellos encendieron"}
          ]
        }
      ]
