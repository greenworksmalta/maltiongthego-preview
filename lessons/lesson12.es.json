          "id": "ex5",
          "title": "Conjuga għamel (hacer) en pasado",
          "instructions": "Elige la forma de pasado correcta para cada pronombre.",
          "choices": ["għamilt", "għamel", "għamlet", "għamilna", "għamiltu", "għamlu"],
          "items": [
            {"pronoun": "Jien", "en": "Yo hice", "answer": "għamilt"},
            {"pronoun": "Int", "en": "Tú hiciste", "answer": "għamilt"},
            {"pronoun": "Hu", "en": "Él hizo", "answer": "għamel"},
            {"pronoun": "Hi", "en": "Ella hizo", "answer": "għamlet"},
            {"pronoun": "Aħna", "en": "Nosotros hicimos", "answer": "għamilna"},
            {"pronoun": "Intom", "en": "Vosotros hicisteis", "answer": "għamiltu"},
            {"pronoun": "Huma", "en": "Ellos hicieron", "answer": "għamlu"}
          ]
        },
        {
          "id": "ex6",
          "title": "Elige el verbo correcto",
          "instructions": "Elige el verbo con għ en pasado que encaja en cada frase.",
          "choices": ["lgħabt", "għażel", "għamlet", "xegħlu", "lgħabna", "għażilt", "xgħeltu", "għażilna"],
          "items": [
            {"sentence": "Jien ___ logħba futbol.", "en": "Jugué un partido de fútbol. (lagħab)", "answer": "lgħabt"},
            {"sentence": "Hu ___ qalziet sabiħ.", "en": "Él eligió unos pantalones bonitos. (għażel)", "answer": "għażel"},
            {"sentence": "Hi ___ platt għaġin tajjeb.", "en": "Ella hizo un buen plato de pasta. (għamel)", "answer": "għamlet"},
            {"sentence": "Huma ___ id-dawl tal-kamra.", "en": "Ellos encendieron la luz de la habitación. (xegħel)", "answer": "xegħlu"},
            {"sentence": "Aħna ___ bil-PlayStation.", "en": "Jugamos a la PlayStation. (lagħab)", "answer": "lgħabna"},
            {"sentence": "Int ___ libsa sabiħa.", "en": "Elegiste un vestido bonito. (għażel)", "answer": "għażilt"},
            {"sentence": "Intom ___ id-dawl.", "en": "Vosotros encendisteis la luz. (xegħel)", "answer": "xgħeltu"},
            {"sentence": "Aħna ___ ktieb sabiħ.", "en": "Elegimos un buen libro. (għażel)", "answer": "għażilna"}
          ]
        }
      ]
