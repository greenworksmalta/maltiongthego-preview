  "sections": [
    {
      "id": "pronouns",
      "icon": "👥",
      "title": "Pronombres",
      "subtitle": "Pronomi Personali — yo, tú, él, ella, nosotros…",
      "intro": "Los pronombres reemplazan a los sustantivos. La mayoría tiene una forma larga y una corta (p. ej. Jien / Jiena ambos significan 'yo'). Usa la que te salga natural.",
      "items": [
        {
          "mt": "Jien",
          "alt": "Jiena",
          "en": "Yo"
        },
        {
          "mt": "Int",
          "alt": "Inti",
          "en": "Tú (singular)"
        },
        {
          "mt": "Hu",
          "alt": "Huwa",
          "en": "Él"
        },
        {
          "mt": "Hi",
          "alt": "Hija",
          "en": "Ella"
        },
        {
          "mt": "Aħna",
          "alt": "Aħna",
          "en": "Nosotros"
        },
        {
          "mt": "Intom",
          "alt": "Intom",
          "en": "Ustedes (plural)"
        },
        {
          "mt": "Huma",
          "alt": "Huma",
          "en": "Ellos"
        }
      ],
      "dialogue": [
        {
          "mt": "Jien naqra ktieb kuljum.",
          "en": "Yo leo un libro todos los días."
        },
        {
          "mt": "Int taqra ħafna?",
          "en": "¿Tú lees mucho?"
        },
        {
          "mt": "Hu jaħdem fl-uffiċċju.",
          "en": "Él trabaja en la oficina."
        },
        {
          "mt": "Hi ssajjar għaġin.",
          "en": "Ella cocina pasta."
        },
        {
          "mt": "Aħna nimxu fil-ġnien.",
          "en": "Nosotros caminamos en el jardín."
        },
        {
          "mt": "Intom titkellmu bil-Malti?",
          "en": "¿Ustedes hablan maltés?"
        },
        {
          "mt": "Huma ġejjin Malta.",
          "en": "Ellos vienen a Malta."
        }
      ],
      "exercises": [
        {
          "id": "ex1",
          "title": "Reemplaza el sustantivo con el pronombre correcto",
          "instructions": "Toca qué pronombre reemplaza al sustantivo subrayado.",
