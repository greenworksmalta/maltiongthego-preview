    {
      "id": "grammar3",
      "icon": "📖",
      "title": "Gramática",
      "subtitle": "Il-grammatika — la gramática de la Lección 3",
      "intro": "Pronombres, demostrativos y las reglas de separación silábica de las diapositivas.",
      "rules": [
        {
          "id": "personal-pronouns",
          "title": "Pronombres personales — sustituyen al sustantivo",
          "explanation": "Los pronombres personales (Jien, Int, Hu, Hi, Aħna, Intom, Huma) sustituyen al sustantivo. Hu/Huwa = él O ello (masculino); Hi/Hija = ella O ello (femenino). Las cosas y los animales también tienen género — un reloj (arloġġ) es 'hu' porque es masculino.",
          "letters": [
            "Jien",
            "Int",
            "Hu",
            "Hi",
            "Aħna",
            "Intom",
            "Huma"
          ],
          "examples": [
            {
              "mt": "Jack imur il-futbol → Hu jmur il-futbol",
              "en": "Jack va al fútbol → Él va al fútbol"
            },
            {
              "mt": "Julia għandha pupa → Hi għandha pupa",
              "en": "Julia tiene una muñeca → Ella tiene una muñeca"
            },
            {
              "mt": "It-tfal raqdu → Huma raqdu",
              "en": "Los niños durmieron → Ellos durmieron"
            },
            {
              "mt": "L-arloġġ kbir → Hu kbir",
              "en": "El reloj es grande → Él (m) es grande"
            },
            {
              "mt": "Il-fjura safra → Hi safra",
              "en": "La flor es amarilla → Ella (f) es amarilla"
            },
            {
              "mt": "Il-karozzi sbieħ → Huma sbieħ",
              "en": "Los coches son hermosos → Ellos son hermosos"
            }
          ]
        },
        {
          "id": "demonstratives-close",
          "title": "Demostrativos — cerca: dan, din, dawn",
          "explanation": "Cuando señalas algo cercano, usa dan (m), din (f), dawn (pl). La forma tiene que concordar con el género y el número del sustantivo.",
          "letters": [
            "Dan (m)",
            "Din (f)",
            "Dawn (pl)"
          ],
          "examples": [
