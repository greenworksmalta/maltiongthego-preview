    {
      "id": "grammar10",
      "icon": "📖",
      "title": "Grammar",
      "subtitle": "Il-grammatika: using the past",
      "intro": "Two things that make the past tense useful: saying you DIDN'T do something, and saying WHEN.",
      "rules": [
        {
          "id": "negative-past",
          "title": "Saying you didn't: the ma...x wrap",
          "explanation": "To make the past negative, wrap the verb: put 'ma' before it and 'x' on the end. Ħdimt (I worked) becomes ma ħdimtx (I didn't work).",
          "examples": [
            {
              "mt": "Ma ħdimtx illum",
              "en": "I didn't work today"
            },
            {
              "mt": "Ma kiltx il-fenek",
              "en": "I didn't eat the rabbit"
            },
            {
              "mt": "Ma mortx ix-xogħol",
              "en": "I didn't go to work"
            },
            {
              "mt": "M'għamilt xejn",
              "en": "I didn't do anything"
            }
          ]
        },
        {
          "id": "time-words",
          "title": "Saying when: yesterday, last week",
          "explanation": "Anchor the past with a time word, usually at the start or end of the sentence.",
          "letters": [
            "ilbieraħ, yesterday",
            "illum, today",
            "il-ġimgħa l-oħra, last week",
            "is-sena l-oħra, last year"
          ],
          "examples": [
            {
              "mt": "Ilbieraħ mort Malta",
              "en": "Yesterday I went to Malta"
            },
            {
              "mt": "Il-ġimgħa l-oħra ħdimt ħafna",
              "en": "Last week I worked a lot"
            },
            {
              "mt": "Is-sena l-oħra mort Għawdex",
              "en": "Last year I went to Gozo"
            }
          ]
        }
      ],
      "exercises": [
        {
          "id": "g10build",
          "type": "build",
          "max": 5,
          "title": "Build the sentence",
          "items": [
            {
              "mt": "Ilbieraħ mort id-dar",
              "en": "Yesterday I went home"
            },
            {
              "mt": "Ma ħdimtx illum",
              "en": "I didn't work today"
            },
            {
              "mt": "Hi kitbet ittra",
              "en": "She wrote a letter"
            },
            {
              "mt": "Għamilna kollox",
              "en": "We did everything"
            },
            {
              "mt": "Huma kielu l-pizza",
              "en": "They ate the pizza"
            }
          ]
        },
        {
          "id": "g10bucket",
          "type": "bucket",
          "batch": 6,
          "title": "Now or before?",
          "instructions": "Sort each verb: is it present (now) or past (before)?",
          "choices": [
            "Present (now)",
            "Past (before)"
          ],
          "items": [
            {
              "word": "naħdem",
              "answer": "Present (now)"
            },
            {
              "word": "ħdimt",
              "answer": "Past (before)"
            },
            {
              "word": "niekol",
              "answer": "Present (now)"
            },
            {
              "word": "kilt",
              "answer": "Past (before)"
            },
            {
              "word": "immur",
              "answer": "Present (now)"
            },
            {
              "word": "mort",
              "answer": "Past (before)"
            }
          ]
        }
      ]
    },
