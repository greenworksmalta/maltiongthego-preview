    {
      "id": "past",
      "icon": "⏪",
      "title": "The past tense",
      "subtitle": "Il-Passat: add an ending, not a prefix",
      "intro": "The present tense added a prefix. The past tense adds an ENDING. Start from what HE did, that is the root, and add an ending for each person.",
      "facts": [
        "The endings are: jien -t, int -t, hu (nothing), hi -et, aħna -na, intom -tu, huma -u.",
        "'Hu' (he did) is the plain root with no ending, it is the form to build from.",
        "Most verbs follow this pattern. A few 'weak' verbs (like mar, went) shift their vowels, watch the last table."
      ],
      "rules": [
        {
          "id": "kiteb",
          "title": "kiteb (he wrote), the model verb",
          "rows": [
            {
              "person": "Jien (I)",
              "ending": "-t",
              "form": "ktibt",
              "en": "I wrote"
            },
            {
              "person": "Int (you)",
              "ending": "-t",
              "form": "ktibt",
              "en": "you wrote"
            },
            {
              "person": "Hu (he)",
              "ending": "-",
              "form": "kiteb",
              "en": "he wrote"
            },
            {
              "person": "Hi (she)",
              "ending": "-et",
              "form": "kitbet",
              "en": "she wrote"
            },
            {
              "person": "Aħna (we)",
              "ending": "-na",
              "form": "ktibna",
              "en": "we wrote"
            },
            {
              "person": "Intom (you pl)",
              "ending": "-tu",
              "form": "ktibtu",
              "en": "you (pl) wrote"
            },
            {
              "person": "Huma (they)",
              "ending": "-u",
              "form": "kitbu",
              "en": "they wrote"
            }
          ]
        },
        {
          "id": "ghamel",
          "title": "għamel (he did / made)",
          "rows": [
            {
              "person": "Jien (I)",
              "ending": "-t",
              "form": "għamilt",
              "en": "I did"
            },
            {
              "person": "Int (you)",
              "ending": "-t",
              "form": "għamilt",
              "en": "you did"
            },
            {
              "person": "Hu (he)",
              "ending": "-",
              "form": "għamel",
              "en": "he did"
            },
            {
              "person": "Hi (she)",
              "ending": "-et",
              "form": "għamlet",
              "en": "she did"
            },
            {
              "person": "Aħna (we)",
              "ending": "-na",
              "form": "għamilna",
              "en": "we did"
            },
            {
              "person": "Intom (you pl)",
              "ending": "-tu",
              "form": "għamiltu",
              "en": "you (pl) did"
            },
            {
              "person": "Huma (they)",
              "ending": "-u",
              "form": "għamlu",
              "en": "they did"
            }
          ]
        },
        {
          "id": "hadem",
          "title": "ħadem (he worked)",
          "rows": [
            {
              "person": "Jien (I)",
              "ending": "-t",
              "form": "ħdimt",
