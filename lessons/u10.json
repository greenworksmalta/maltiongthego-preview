{
  "id": "u10",
  "title": "At Work & At Home",
  "subtitle": "Ix-xogħol u d-dar: jobs, your home, and what you did",
  "sections": [
    {
      "id": "day",
      "icon": "🗓️",
      "title": "How was your day?",
      "subtitle": "X'għamilt illum: the past tense in the wild",
      "intro": "A short chat about the day. Listen for the '-t' endings, that is the past tense. We explain it right after.",
      "dialogue": [
        {
          "mt": "Fejn ħdimt illum?",
          "en": "Where did you work today?"
        },
        {
          "mt": "Ħdimt fl-uffiċċju.",
          "en": "I worked in the office."
        },
        {
          "mt": "X'għamilt wara?",
          "en": "What did you do after?"
        },
        {
          "mt": "Mort id-dar u kilt.",
          "en": "I went home and ate."
        },
        {
          "mt": "U lbieraħ x'għamilt?",
          "en": "And yesterday, what did you do?"
        },
        {
          "mt": "Ilbieraħ ma ħdimtx, mort il-baħar!",
          "en": "Yesterday I didn't work, I went to the sea!"
        }
      ]
    },
    {
