      "exercises": [
        {
          "id": "ex5",
          "title": "Conjuga kiteb (escribir) en pasado",
          "instructions": "Elige la forma de pasado correcta para cada pronombre.",
          "choices": ["ktibt", "kiteb", "kitbet", "ktibna", "ktibtu", "kitbu"],
          "items": [
            {"pronoun": "Jien", "en": "Yo escribí", "answer": "ktibt"},
            {"pronoun": "Int", "en": "Tú escribiste", "answer": "ktibt"},
            {"pronoun": "Hu", "en": "Él escribió", "answer": "kiteb"},
            {"pronoun": "Hi", "en": "Ella escribió", "answer": "kitbet"},
            {"pronoun": "Aħna", "en": "Nosotros escribimos", "answer": "ktibna"},
            {"pronoun": "Intom", "en": "Vosotros escribisteis", "answer": "ktibtu"},
            {"pronoun": "Huma", "en": "Ellos escribieron", "answer": "kitbu"}
          ]
        },
        {
          "id": "ex6",
          "title": "Elige el verbo correcto",
          "instructions": "Elige el verbo en pasado que encaja en cada frase.",
          "choices": ["rqadt", "ħareġ", "marret", "telqu", "ktibt", "rkibt", "dħalna", "ħdimtu"],
          "items": [
            {"sentence": "Jien ___ tard.", "en": "Dormí tarde. (raqad)", "answer": "rqadt"},
            {"sentence": "Hu ___ kmieni.", "en": "Él salió temprano. (ħareġ)", "answer": "ħareġ"},
            {"sentence": "Hi ___ fil-ħin.", "en": "Ella fue a tiempo. (mar)", "answer": "marret"},
            {"sentence": "Huma ___ jiġru.", "en": "Ellos se fueron corriendo. (telaq)", "answer": "telqu"},
            {"sentence": "Jien ___ ittra.", "en": "Escribí una carta. (kiteb)", "answer": "ktibt"},
            {"sentence": "Int ___ tal-linja.", "en": "Cogiste el autobús. (rikeb)", "answer": "rkibt"},
            {"sentence": "Aħna ___ ġo kamra kbira.", "en": "Entramos en una habitación grande. (daħal)", "answer": "dħalna"},
            {"sentence": "Intom ___ ħafna.", "en": "Vosotros trabajasteis mucho. (ħadem)", "answer": "ħdimtu"}
          ]
        }
      ]
