    {
      "id": "grammar11",
      "icon": "📝",
      "title": "Gramática",
      "subtitle": "Il-grammatika — la gramática de la Lección 11",
      "intro": "El pasado explicado — la mamma, los sufijos, la raíz y los verbos irregulares.",
      "rules": [
        {
          "id": "mamma-suffixes",
          "title": "La mamma y los siete sufijos",
          "explanation": "El pasado se construye sobre la mamma — la forma desnuda de 'él'. A ella se añade un sufijo para cada persona. Hu no lleva ningún sufijo (ES la mamma).",
          "letters": ["Jien -t", "Int -t", "Hu —", "Hi -et", "Aħna -na", "Intom -tu", "Huma -u"],
          "examples": [
            {"mt": "Hu kiteb", "en": "Él escribió — la mamma, sin sufijo"},
            {"mt": "Jien ktibt", "en": "Yo escribí — mamma + -t"},
            {"mt": "Hi kitbet", "en": "Ella escribió — mamma + -et"},
            {"mt": "Huma kitbu", "en": "Ellos escribieron — mamma + -u"}
          ]
        },
        {
          "id": "root-vowel",
          "title": "La raíz y la vocal que cambia",
          "explanation": "La mayoría de los verbos malteses se apoyan en una raíz de tres consonantes. En kiteb la raíz es k-t-b. Al añadir los sufijos, esas tres consonantes se quedan fijas pero las vocales a su alrededor se desplazan — este sistema de raíz y patrón se hereda del árabe y es típico de las lenguas semíticas.",
          "examples": [
            {"mt": "kiteb — ktibt — kitbet — kitbu", "en": "escribir: la raíz k-t-b se queda, las vocales se mueven"},
            {"mt": "ħareġ — ħriġt — ħarġet", "en": "salir: la raíz ħ-r-ġ se queda"}
          ]
        },
        {
          "id": "weak-roots",
          "title": "Raíces débiles — verbos irregulares",
          "explanation": "Algunos verbos tienen una 'letra débil' en la raíz — en maltés, l-għerq dgħajjef. El verbo mar (ir) tiene la raíz m-w-r; la w es débil y desaparece o se transforma al añadir los sufijos, así que el verbo cambia bastante de forma.",
          "examples": [
            {"mt": "mar — mort", "en": "él fue — yo fui"},
            {"mt": "marret — morna — marru", "en": "ella fue — nosotros fuimos — ellos fueron"}
          ]
        }
      ]
    }
