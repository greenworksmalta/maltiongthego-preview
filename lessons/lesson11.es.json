        {"mt": "l-omnibus", "en": "el ómnibus — el primer transporte público de Malta, tirado por tres caballos"},
        {"mt": "il-ferrovija", "en": "el ferrocarril — el Tren de Malta, de La Valeta a Mdina (1883–1931)"},
        {"mt": "it-tramm", "en": "el tranvía — un tranvía eléctrico de dos pisos, funcionó de 1905 a 1929"},
        {"mt": "il-karozza tal-linja", "en": "el autobús de línea — el transporte público principal hoy"},
        {"mt": "il-vapur ta' Għawdex", "en": "el ferry de Gozo — el enlace marítimo entre Malta y Gozo"}
