            {"person": "Int", "pronoun": "Int", "form": "għamilt", "en": "you made"},
            {"person": "Hu", "pronoun": "Hu", "form": "għamel", "en": "he made (mamma)"},
            {"person": "Hi", "pronoun": "Hi", "form": "għamlet", "en": "she made"},
            {"person": "Aħna", "pronoun": "Aħna", "form": "għamilna", "en": "we made"},
            {"person": "Intom", "pronoun": "Intom", "form": "għamiltu", "en": "you (pl) made"},
