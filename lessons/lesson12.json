          "instructions": "Pick the past-tense għ-verb that fits each sentence.",
          "choices": ["lgħabt", "għażel", "għamlet", "xegħlu", "lgħabna", "għażilt", "xgħeltu", "għażilna"],
          "items": [
            {"sentence": "Jien ___ logħba futbol.", "en": "I played a game of football. (lagħab)", "answer": "lgħabt"},
