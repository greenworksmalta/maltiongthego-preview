        {
          "id": "ex5",
          "title": "Conjugate għamel (to make) in the past",
          "instructions": "Pick the correct past-tense form for each pronoun.",
          "choices": ["għamilt", "għamel", "għamlet", "għamilna", "għamiltu", "għamlu"],
          "items": [
            {"pronoun": "Jien", "en": "I made", "answer": "għamilt"},
            {"pronoun": "Int", "en": "You made", "answer": "għamilt"},
            {"pronoun": "Hu", "en": "He made", "answer": "għamel"},
            {"pronoun": "Hi", "en": "She made", "answer": "għamlet"},
            {"pronoun": "Aħna", "en": "We made", "answer": "għamilna"},
            {"pronoun": "Intom", "en": "You (pl) made", "answer": "għamiltu"},
            {"pronoun": "Huma", "en": "They made", "answer": "għamlu"}
          ]
        },
        {
          "id": "ex6",
