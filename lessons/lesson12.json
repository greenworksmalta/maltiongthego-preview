    {
      "id": "grammar12",
      "icon": "📝",
      "title": "Grammar",
      "subtitle": "Il-grammatika — the grammar of Lesson 12",
      "intro": "The past tense again — a quick recap, then the special behaviour of verbs whose root contains għ.",
      "rules": [
        {
          "id": "past-recap",
          "title": "The past tense — quick recap",
          "explanation": "The past tense is the mamma (the bare 'he' form) plus a personal suffix. Hu takes no suffix. The three root consonants stay fixed while the vowels shift.",
          "letters": ["Jien -t", "Int -t", "Hu —", "Hi -et", "Aħna -na", "Intom -tu", "Huma -u"],
          "examples": [
            {"mt": "Hu għamel", "en": "He made — the mamma"},
            {"mt": "Jien għamilt", "en": "I made — mamma + -t"},
            {"mt": "Huma għamlu", "en": "They made — mamma + -u"}
          ]
        },
        {
          "id": "gh-at-start",
          "title": "għ at the start of the root",
          "explanation": "When għ is the first letter of the root — as in għamel (root għ-m-l) and għażel (root għ-ż-l) — the għ stays at the front through the whole conjugation; only the vowels after it move.",
          "examples": [
            {"mt": "għamel — għamilt — għamlet", "en": "to make: he / I / she made"},
            {"mt": "għażel — għażilt — għażlu", "en": "to choose: he / I made — they chose"}
          ]
        },
        {
          "id": "gh-in-middle",
          "title": "għ in the middle of the root",
          "explanation": "When għ sits in the middle of the root — as in lagħab (root l-għ-b) and xegħel (root x-għ-l) — the verb shifts more noticeably. In the I / you / we forms the first vowel drops: lagħab → lgħabt, xegħel → xgħelt.",
          "examples": [
            {"mt": "lagħab — lgħabt — lagħbet", "en": "to play: he / I / she played"},
            {"mt": "xegħel — xgħelt — xegħlu", "en": "to switch on: he / I switched on — they switched on"}
          ]
        }
      ]
    }
  ]
