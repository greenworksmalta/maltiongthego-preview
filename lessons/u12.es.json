    {
      "id": "nannu12",
      "icon": "👴",
      "title": "Hablando con el abuelo · una charla",
      "subtitle": "Diálogo con un abuelo sobre cómo eran las cosas",
      "intro": "Mary pregunta a su abuelo por la Malta antigua. Fíjate en kont: aparece en casi todas las frases.",
      "dialogue": [
        {
          "mt": "Nannu, kif kont tmur għax-xogħol meta kont żgħir?",
          "en": "Abuelo, ¿cómo ibas al trabajo cuando eras joven?"
        },
        {
          "mt": "Kont immur bit-tramm jew bil-karozza tal-linja.",
          "en": "Iba en tranvía o en autobús."
        },
        {
          "mt": "U l-ferrovija kont tużaha?",
          "en": "¿Y el ferrocarril, lo usabas?"
        },
        {
          "mt": "Iva, kont nuża l-ferrovija ukoll.",
          "en": "Sí, también usaba el ferrocarril."
        },
        {
          "mt": "Fejn kont taħdem?",
          "en": "¿Dónde trabajabas?"
        },
        {
          "mt": "Jien kont ħaddied.",
          "en": "Yo era herrero."
        },
        {
          "mt": "Kont issib ħwienet tal-ħelu?",
          "en": "¿Había alguna tienda de dulces?"
        },
        {
          "mt": "Iva, kont niekol ħelu kuljum!",
          "en": "¡Sí, comía dulces todos los días!"
        },
        {
          "mt": "Kemm hu interessanti nisma' fuq il-passat, nannu!",
          "en": "¡Qué interesante es oír hablar del pasado, abuelo!"
        }
      ],
      "exercises": [
        {
          "id": "ex3",
          "type": "build",
          "max": 4,
          "items": [
            {
              "mt": "Kont immur bit-tramm jew bil-karozza tal-linja.",
              "en": "Iba en tranvía o en autobús."
            },
            {
              "mt": "Fejn kont taħdem?",
              "en": "¿Dónde trabajabas?"
            },
            {
              "mt": "Jien kont ħaddied.",
              "en": "Yo era herrero."
            },
            {
              "mt": "Kemm hu interessanti nisma' fuq il-passat, nannu!",
              "en": "¡Qué interesante es oír hablar del pasado, abuelo!"
            }
          ]
        }
      ]
    },
    {
      "id": "kont12",
      "icon": "🕰️",
      "title": "El pasado de ser",
      "subtitle": "El verbo kien, y cómo kont forma 'solía'",
      "intro": "Ya conoces las terminaciones del pasado por kiteb y ħadem. El verbo kien lleva las mismas.",
      "rules": [
        {
          "id": "kien",
          "title": "kien (él era): las mismas terminaciones que ya conoces",
          "rows": [
            {
              "person": "Jien (I)",
              "ending": "-t",
              "form": "kont",
              "en": "yo era",
              "say": "Jien kont"
            },
            {
              "person": "Int (you)",
              "ending": "-t",
              "form": "kont",
              "en": "tú eras",
              "say": "Int kont"
            },
            {
              "person": "Hu (he)",
              "ending": "-",
              "form": "kien",
              "en": "él era",
              "say": "Hu kien"
            },
            {
              "person": "Hi (she)",
              "ending": "-et",
              "form": "kienet",
              "en": "ella era",
              "say": "Hi kienet"
            },
            {
              "person": "Aħna (we)",
              "ending": "-na",
              "form": "konna",
              "en": "nosotros éramos",
              "say": "Aħna konna"
            },
            {
              "person": "Intom (you)",
              "ending": "-tu",
              "form": "kontu",
              "en": "vosotros erais",
              "say": "Intom kontu"
            },
            {
              "person": "Huma (they)",
              "ending": "-u",
              "form": "kienu",
              "en": "ellos eran",
              "say": "Huma kienu"
            }
          ]
        }
      ],
      "facts": [
        "kont + un verbo = 'solía'. Kont immur = solía ir. Kont niekol = solía comer.",
        "kont + un sustantivo = 'era'. Jien kont ħaddied = yo era herrero.",
        "El plural de ħanut es ħwienet, una de las formas irregulares de la Unidad 11."
      ]
    },
    {
      "id": "grammar12",
      "icon": "📖",
      "title": "Gramática",
      "subtitle": "Il-grammatika: decir que no eras, y preguntar por el pasado",
      "intro": "Tres cosas que hacen útil a kont: decir que no eras, decir que había, y preguntarle a alguien por su pasado.",
      "rules": [
        {
          "id": "negative-kont",
          "title": "Decir que no eras: el cerco ma...x",
          "explanation": "Ya viste este cerco con otros verbos en la Unidad 10. Kien lo lleva igual: ma delante y x al final. Kont (yo era) pasa a ma kontx (yo no era).",
          "examples": [
            {
              "mt": "Ma kontx naħdem bħala ħaddied",
              "en": "No trabajaba como herrero"
            },
            {
              "mt": "Ma kontx immur bit-tramm",
              "en": "No solía ir en tranvía"
            },
            {
              "mt": "Ma kienx hemm ferrovija",
              "en": "No había ferrocarril"
            },
            {
              "mt": "Ma konniex id-dar",
              "en": "No estábamos en casa"
            }
          ]
        },
        {
          "id": "kien-hemm",
          "title": "Kien hemm: había",
          "explanation": "Kien hemm sirve para había en singular y en plural. No cambia. Fíjate en el nombre del lugar: fil-belt, con b minúscula, es en la ciudad, cualquier ciudad. il-Belt con B mayúscula es La Valeta y no lleva preposición.",
          "examples": [
            {
              "mt": "Kien hemm ħanut tal-ħelu f'kull raħal",
              "en": "Había una tienda de dulces en cada pueblo"
            },
            {
              "mt": "Kien hemm ħafna ħwienet fil-belt",
              "en": "Había muchas tiendas en la ciudad"
            },
            {
              "mt": "Kien hemm ħafna ħwienet il-Belt Valletta",
              "en": "Había muchas tiendas en La Valeta"
            },
            {
              "mt": "Ma kienx hemm karozzi",
              "en": "No había coches"
            }
          ]
        },
        {
          "id": "asking-past",
          "title": "Preguntar por el pasado",
          "explanation": "Pon una palabra interrogativa delante de kont y puedes preguntarle a cualquiera por su pasado.",
          "letters": [
            "fejn, dónde",
            "kif, cómo",
            "meta, cuándo",
            "x', qué"
          ],
          "examples": [
            {
              "mt": "Fejn kont taħdem?",
              "en": "¿Dónde trabajabas?"
            },
            {
              "mt": "Kif kont tmur għax-xogħol?",
              "en": "¿Cómo ibas al trabajo?"
            },
            {
              "mt": "X'kont taħdem?",
              "en": "¿En qué trabajabas?"
            },
            {
              "mt": "Meta kont hemm?",
              "en": "¿Cuándo estuviste allí?"
            }
          ]
        }
      ],
      "exercises": [
        {
          "id": "g12build",
          "type": "build",
          "max": 4,
          "title": "Construye la frase",
          "items": [
            {
              "mt": "Ma kontx naħdem bħala ħaddied",
              "en": "No trabajaba como herrero"
            },
            {
              "mt": "Kien hemm ħanut tal-ħelu f'kull raħal",
              "en": "Había una tienda de dulces en cada pueblo"
            },
            {
              "mt": "Fejn kont taħdem?",
              "en": "¿Dónde trabajabas?"
            },
            {
              "mt": "Ma kienx hemm ferrovija",
              "en": "No había ferrocarril"
            }
          ]
        }
      ]
    },
