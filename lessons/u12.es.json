    {
      "id": "transport12",
      "icon": "🚊",
      "title": "Cómo moverse",
      "subtitle": "Cómo se movía Malta, antes y ahora",
      "intro": "De una mula y dos ruedas de madera a los autobuses y ferris de hoy.",
      "vocab": [
        {
          "mt": "il-kaless",
          "en": "la calesa",
          "icon": "🐴",
          "note": "Dos ruedas grandes de madera y una mula o un caballo. El conductor iba a pie al lado."
        },
        {
          "mt": "il-karozzin",
          "en": "el carruaje de caballos",
          "icon": "🎠",
          "note": "Desde 1856. Cerrado y con muelles, y esta vez el conductor podía ir sentado."
        },
        {
          "mt": "l-omnibus",
          "en": "el ómnibus",
          "icon": "🚋",
          "note": "El primer transporte público de Malta: tres caballos, veintidós pasajeros."
        },
        {
          "mt": "il-ferrovija",
          "en": "el ferrocarril",
          "icon": "🚂",
          "note": "De La Valeta a Mdina, desde 1883 hasta que cerró en 1931."
        },
        {
          "mt": "it-tramm",
          "en": "el tranvía",
          "icon": "🚊",
          "note": "Desde 1905, con piso superior e inferior."
        },
        {
          "mt": "il-karozza tal-linja",
          "en": "el autobús",
          "icon": "🚌",
          "note": "Los dueños pintaban sus propios autobuses; el servicio actual empezó en 2014."
        },
        {
          "mt": "il-vapur ta' Għawdex",
          "en": "el ferry de Gozo",
          "icon": "⛴️",
          "note": "Gozo Channel opera la travesía desde 1979."
        },
        {
          "mt": "il-lanċa tal-passiġġieri",
          "en": "la lancha de pasajeros",
          "icon": "🚤",
          "note": "Pequeñas embarcaciones siguen cruzando el puerto con pasajeros."
        },
        {
          "mt": "il-luzzu",
          "en": "una barca de pesca tradicional maltesa",
          "icon": "🎣",
          "note": "La barca de pesca con un ojo pintado en la proa."
        }
