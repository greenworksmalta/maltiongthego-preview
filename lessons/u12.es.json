  "sections": [
    {
      "id": "shops12",
      "icon": "🏪",
      "title": "Tiendas antiguas",
      "subtitle": "Tiendas antiguas y los oficios que había detrás",
      "intro": "Cada pueblo tenía estas tiendas. Casi todos los oficios han desaparecido, pero las palabras siguen en carteles y nombres de calles.",
      "vocab": [
        {
          "mt": "il-barbier",
          "en": "el barbero",
          "icon": "💈",
          "note": "También afeitaba a los clientes, y la tienda era donde corrían las noticias del pueblo."
        },
        {
          "mt": "il-furnar",
          "en": "el panadero",
          "icon": "🥖",
          "note": "Las familias traían su propia masa para que se la hornearan."
        },
        {
          "mt": "il-ħajjat",
          "en": "el sastre",
          "icon": "🧵",
          "note": "La ropa se remendaba y se arreglaba, no se reemplazaba."
        },
        {
          "mt": "l-iskarpan",
          "en": "el zapatero",
          "icon": "👞",
          "note": "Reparaba zapatos hasta que llegó el calzado barato de fábrica."
        },
        {
          "mt": "il-ħaddied",
          "en": "el herrero",
          "icon": "🔨",
          "note": "Trabajaba el hierro para herramientas y cosas de casa."
        },
        {
          "mt": "il-ħanut tal-merċa",
          "en": "la tienda de comestibles",
          "icon": "🛒",
          "note": "Vendía a granel, pesado en el momento, no en paquetes."
        },
        {
          "mt": "il-ħanut tal-ħelu",
          "en": "la tienda de dulces",
          "icon": "🍬",
          "note": "Pequeña, familiar, y adorada por los niños."
        },
        {
          "mt": "il-ħanut tal-gazzetti",
          "en": "el quiosco",
          "icon": "📰",
          "note": "Periódicos y revistas, locales y extranjeros."
        },
        {
          "mt": "il-ħanut tat-te",
          "en": "la casa de té",
          "icon": "☕",
          "note": "Un sitio para sentarse, charlar y beber; más social que comercial."
        }
