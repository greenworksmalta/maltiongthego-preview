    {
      "id": "grammar10",
      "icon": "📝",
      "title": "Grammar",
      "subtitle": "Il-grammatika — the grammar of Lesson 10",
      "intro": "The grammar points from the slides — the article, and how nouns change for gender and number.",
      "rules": [
        {
          "id": "article-summary",
          "title": "The article — il-, l- and assimilation",
          "explanation": "'The' is il- by default, l- before a vowel (and usually għ / h). Before a 'Xemxin' consonant (ċ, d, n, r, s, t, x, ż, z) the l doubles to match: id-dar, ix-xemx. The fifteen 'Qamrin' consonants keep il-/l-: il-baħar, l-arloġġ.",
          "letters": ["il-", "l-", "iċ-", "id-", "in-", "ir-", "is-", "it-", "ix-", "iż-", "iz-"],
          "examples": [
            {"mt": "id-dar", "en": "the house — 'Xemxin' consonant"},
            {"mt": "il-baħar", "en": "the sea — 'Qamrin' consonant"},
            {"mt": "l-omm", "en": "the mother — before a vowel"}
          ]
        },
        {
          "id": "feminine-rule",
          "title": "Making the feminine",
          "explanation": "Most jobs and animals form the feminine by adding -a to the masculine: tabib → tabiba, kok → koka, kelb → kelba, qattus → qattusa. A few add -ja (bidwi → bidwija) or have their own word (barri → baqra, serduk → tiġieġa).",
          "examples": [
            {"mt": "tabib — tabiba", "en": "doctor (m.) — doctor (f.)"},
            {"mt": "kelb — kelba", "en": "dog — female dog"},
