    {
      "id": "grammar",
      "icon": "📖",
      "title": "The Article",
      "subtitle": "L-artiklu — saying 'the' in Maltese",
      "intro": "Maltese has one article for 'the'. It is written il- or l- and joined to the noun with a hyphen. But the spelling shifts depending on the first letter of the word — read the rules, then try the exercises.",
      "rules": [
        {
          "id": "the-article",
          "title": "il- and l- — the article",
          "explanation": "The Maltese article is formed by adding il- (or l-) to the front of a noun or adjective. It defines the noun — it turns 'a family' into 'the family'.",
          "examples": [
            {"mt": "il-familja", "en": "the family (familja → il-familja)"},
            {"mt": "il-kuġin", "en": "the cousin (kuġin → il-kuġin)"},
            {"mt": "il-baħar", "en": "the sea"},
            {"mt": "il-labra", "en": "the needle"}
          ]
        },
        {
          "id": "before-vowel",
          "title": "Before a vowel — use l-",
          "explanation": "If the word starts with a vowel (a, e, i, ie, o, u) the i of the article drops and you use just l-. This rule normally also applies to words beginning with għ and h.",
          "examples": [
            {"mt": "l-omm", "en": "the mother"},
            {"mt": "l-aħwa", "en": "the brothers / sisters"},
            {"mt": "l-għasfur", "en": "the bird"},
            {"mt": "l-hena", "en": "the joy"}
          ]
        },
        {
          "id": "sun-consonants",
          "title": "'Xemxin' consonants — the l assimilates",
          "explanation": "There are nine 'Xemxin' consonants: ċ, d, n, r, s, t, x, ż and z. When a word starts with one of these, the l of il-/l- changes to match that consonant — so you double it.",
          "letters": ["ċ", "d", "n", "r", "s", "t", "x", "ż", "z"],
          "examples": [
            {"mt": "iċ-ċurkett", "en": "the ring"},
            {"mt": "id-dar", "en": "the house"},
            {"mt": "in-nar", "en": "the fire"},
            {"mt": "ir-raġel", "en": "the man"},
            {"mt": "ix-xalla", "en": "the scarf"},
            {"mt": "iż-żejt", "en": "the oil"},
            {"mt": "iz-zokkor", "en": "the sugar"}
          ]
        },
        {
          "id": "moon-consonants",
          "title": "'Qamrin' consonants — keep il- or l-",
          "explanation": "The fifteen 'Qamrin' consonants — b, f, ġ, g, għ, h, ħ, j, k, l, m, p, q, v and w — do NOT assimilate. They simply take il- (or l- when the word starts with a vowel, għ or h).",
          "letters": ["b", "f", "ġ", "g", "għ", "h", "ħ", "j", "k", "l", "m", "p", "q", "v", "w"],
          "examples": [
            {"mt": "il-baħar", "en": "the sea"},
            {"mt": "il-ġebla", "en": "the rock"},
            {"mt": "il-kelb", "en": "the dog"},
            {"mt": "l-arloġġ", "en": "the clock"},
            {"mt": "l-għaġin", "en": "the pasta"}
          ]
        },
        {
          "id": "vowel-before",
          "title": "A vowel before the article — drop the i",
          "explanation": "When the word just before the article ends a phrase with a vowel, the i of the article is dropped: 'Mort nixtri iċ-ċurkett' becomes 'Mort nixtri ċ-ċurkett'.",
          "examples": [
            {"mt": "Mort nixtri ċ-ċurkett", "en": "I went to buy the ring"},
            {"mt": "Jien inħobb ħafna x-xemx", "en": "I really love the sun"}
          ]
        }
      ],
      "exercises": [
        {
          "id": "ex3",
          "title": "'Xemxin' consonants — pick the article",
          "instructions": "Choose the article that matches the first letter of the word.",
          "choices": ["iċ-", "id-", "in-", "ir-", "is-", "it-", "ix-", "iż-"],
          "items": [
            {"word": "ċavetta", "answer": "iċ-", "en": "the key"},
            {"word": "dar", "answer": "id-", "en": "the house"},
            {"word": "nar", "answer": "in-", "en": "the fire"},
            {"word": "raġel", "answer": "ir-", "en": "the man"},
            {"word": "serp", "answer": "is-", "en": "the snake"},
            {"word": "tifel", "answer": "it-", "en": "the boy"},
            {"word": "xemx", "answer": "ix-", "en": "the sun"},
            {"word": "żunżana", "answer": "iż-", "en": "the wasp"},
            {"word": "ċurkett", "answer": "iċ-", "en": "the ring"},
            {"word": "triq", "answer": "it-", "en": "the road"}
          ]
        },
        {
          "id": "ex4",
          "title": "'Qamrin' consonants — il- or l-?",
          "instructions": "'Qamrin' consonants keep il-; use l- only when the word starts with a vowel, għ or h.",
          "choices": ["il-", "l-"],
          "items": [
            {"word": "baħar", "answer": "il-", "en": "the sea"},
            {"word": "labra", "answer": "il-", "en": "the needle"},
            {"word": "ġebla", "answer": "il-", "en": "the rock"},
            {"word": "qattus", "answer": "il-", "en": "the cat"},
            {"word": "ħuta", "answer": "il-", "en": "the fish"},
            {"word": "kelb", "answer": "il-", "en": "the dog"},
            {"word": "arloġġ", "answer": "l-", "en": "the clock"},
            {"word": "għaġin", "answer": "l-", "en": "the pasta"},
            {"word": "ors", "answer": "l-", "en": "the bear"},
            {"word": "iljun", "answer": "l-", "en": "the lion"}
          ]
        },
        {
          "id": "ex5",
          "title": "Mixed — pick the article",
          "instructions": "'Xemxin' or 'Qamrin'? Choose the correct article for each word.",
          "choices": ["il-", "l-", "iċ-", "id-", "in-", "ir-", "is-", "ix-", "iż-"],
          "items": [
            {"word": "omm", "answer": "l-", "en": "the mother"},
            {"word": "dar", "answer": "id-", "en": "the house"},
            {"word": "ċurkett", "answer": "iċ-", "en": "the ring"},
            {"word": "baħar", "answer": "il-", "en": "the sea"},
            {"word": "nar", "answer": "in-", "en": "the fire"},
            {"word": "raġel", "answer": "ir-", "en": "the man"},
            {"word": "xemx", "answer": "ix-", "en": "the sun"},
            {"word": "żejt", "answer": "iż-", "en": "the oil"},
            {"word": "siġra", "answer": "is-", "en": "the tree"},
            {"word": "għasfur", "answer": "l-", "en": "the bird"}
          ]
        }
      ]
    },
