    {
      "id": "questions",
      "icon": "❓",
      "title": "Palabras de pregunta",
      "subtitle": "Mistoqsijiet — preguntar quién, qué, cuándo, dónde, por qué",
      "items": [
        {
          "mt": "Min?",
          "en": "¿Quién?",
          "example": "Min hu l-għalliem tiegħek?",
          "example_en": "¿Quién es tu maestro?"
        },
        {
          "mt": "Fejn?",
          "en": "¿Dónde?",
          "example": "Fejn toqgħod?",
          "example_en": "¿Dónde vives?"
        },
        {
          "mt": "Xi?",
          "alt": "Xiex?",
          "en": "¿Qué?/¿Cuántos?",
          "example": "X'tieħu?",
          "example_en": "¿Qué vas a tomar?"
        },
        {
          "mt": "Għaliex?",
          "alt": "Għala?",
          "en": "¿Por qué?",
          "example": "Għaliex int hawn?",
          "example_en": "¿Por qué estás aquí?"
        },
        {
          "mt": "Meta?",
          "en": "¿Cuándo?",
          "example": "Meta ġej il-vapur?",
          "example_en": "¿Cuándo llega el barco?"
        },
        {
          "mt": "Liema?",
          "en": "¿Cuál?",
          "example": "Liema tip ta' kapuċċino trid?",
          "example_en": "¿Qué tipo de capuchino quieres?"
        },
        {
          "mt": "Ta' min?",
          "en": "¿De quién?",
          "example": "Ta' min hi din il-borża?",
          "example_en": "¿De quién es esta bolsa?"
        },
        {
          "mt": "Kif?",
          "en": "¿Cómo?",
          "example": "Kif tasal hemm?",
          "example_en": "¿Cómo llegas allá?"
        }
      ],
      "passage": {
        "title": "Lee y responde",
        "lines": [
          {
            "mt": "Nhar il-Ħamis, Sara u Tom marru jieklu f'ristorant fl-Imdina.",
            "en": "El jueves, Sara y Tom fueron a comer a un restaurante en Mdina."
          },
          {
            "mt": "Bdew bi platt timpana u soppa tal-armla.",
            "en": "Empezaron con un plato de timpana y sopa de la viuda."
          },
          {
            "mt": "Tom ipprova l-fenek għall-ewwel darba u tant ħa pjaċir bih.",
            "en": "Tom probó el conejo por primera vez y le encantó."
          },
          {
            "mt": "Wara, qassmu kannol u ħadu kapuċċino.",
            "en": "Después, compartieron un cannolo y tomaron un capuchino."
          },
          {
            "mt": "Il-wejter qalilhom: 'Saħħa! Erġgħu lura għada.'",
            "en": "El mesero les dijo: '¡Salud! Vuelvan mañana.'"
          }
        ],
        "questions": [
          {
            "q": "Fejn marru Sara u Tom?",
            "qen": "¿A dónde fueron Sara y Tom?",
            "a": "Marru f'ristorant fl-Imdina.",
            "aen": "Fueron a un restaurante en Mdina."
          },
          {
            "q": "Min ipprova l-fenek?",
            "qen": "¿Quién probó el conejo?",
            "a": "Tom ipprova l-fenek.",
            "aen": "Tom probó el conejo."
          },
          {
            "q": "Meta marru jieklu?",
            "qen": "¿Cuándo fueron a comer?",
            "a": "Marru nhar il-Ħamis.",
            "aen": "Fueron el jueves."
          },
          {
            "q": "X' qasmu wara?",
            "qen": "¿Qué compartieron después?",
            "a": "Qassmu kannol.",
            "aen": "Compartieron un cannolo."
          }
        ]
      }
    },
